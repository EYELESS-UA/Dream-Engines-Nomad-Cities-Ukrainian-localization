{
	missions: {
		welcome-no-tut: {
			name: "ようこそ"
			desc: "Dream Enginesへようこそ。\nチュートリアルは無効になっていますが、画面の右上にある<highlight>マイルストーン</highlight>があなたを導いてくれます。マウスポインタをマイルストーンにかざすと、その詳細を知ることができます。\n\n<highlight>「Tab」</highlight>を押すと、戦闘モードと都市管理モードが切り替わります。"
		}
		welcome-pre-fortifications-save: {
			name: "前回のセーブからの重大変更"
			desc: "ドリーム・エンジンへようこそ。前回のセーブから新しいアップデートをリリースしました。今回のアップデートでは、敵の襲撃に関する変更が含まれており、 <highlight>気づかずに </highlight>いると <highlight>殺される </highlight>可能性があります。ここでは、最も重要な変更点をいくつか紹介します:\n\n*襲撃中の敵は、前方を塞がない限り、 <highlight>壁を無視 </highlight>するようになりました。壁もより頑丈になりました。\n\n*徘徊する敵は時折、 <highlight>前触れなし </highlight>に <highlight>街や建物を攻撃 </highlight>してきます。攻撃力は襲撃時よりずっと弱いですが、すべての建物をしっかりと守る必要があります。\n\n*ティア2以上の大型敵は<highlight>装甲</highlight>されました。木製タレットやライトクロスボウが与える<highlight>ダメージは半減</highlight>します。より高度なタレットに交換することをお勧めします。\n\n* ゲームに<highlight>石製タレットと壁</highlight>が追加されました。"
		}
		welcome: {
			name: "ようこそ。"
			texts: {
				desc: "Dream Enginesへようこそ。\nこの<highlight>チュートリアル</highlight>では、ゲームの基本的な操作方法をご紹介します。\n\nこれはあくまでもゲームガイドであり、ゲームに影響を与えるものではありませんので、チュートリアル中に自分の都市が破壊されても負けてしまいます。"
				desc2: "画面 <highlight>右上 <highlight>の指示に従ってください。"
			}
		}
		images: {
			name: "チュートリアルの操作について"
			texts: {
				intro: "このようなチュートリアルメッセージには、動画や画像によるビジュアルガイドが含まれているものがあります。ビデオアイコンにマウスを乗せるとご覧になれます。"
				previous: "F1キーまたはゲーム（ESC）メニューのヘルプボタンを押すと、ジャーナルで過去全てのチュートリアルを確認することができます。"
				pause: "また、ゲームを一時停止して、チュートリアルのメッセージをゆっくり読むこともできます。スペースキーを押すと、いつでもゲームを一時停止／再生することができます。"
			}
			objectives: {
				hover-video: "上のビデオアイコンにカーソルを合わせてください。"
				unpause: "ゲームの一時停止と再生"
			}
		}
		movement: {
			name: "移動"
			texts: {
				intro: "監督として、古代の装甲探査ユニットである<highlight>Tiny</highlight>を操作します。"
				move: "<highlight>WASD</highlight>キーでタイニーを移動してください。"
				zoom: "<highlight>mouse scroll wheel</highlight>を使って、ズームイン、ズームアウトすることができます。"
				rotate: "<highlight>マウスホイール</highlight>を押したまま、カメラを回転してください。"
			}
			objectives: {
				movemech: "動き回る"
				movemech-hover: "監督として、古代の装甲探査ユニットである<highlight>Tiny</highlight>を操作します。\n\n<highlight>WASD</highlight>キーで移動します。"
				zoom: "ズームの変更"
				zoom-hover: "<highlight>mouse scroll wheel</highlight>を使って、ズームイン、ズームアウトすることができます。"
				rotate: "カメラの回転"
				rotate-hover: "<highlight>マウスのミドルボタン</highlight>を押しながらマウスを動かすと、カメラが回転します。\n\n<highlight>「N」</highlight>を押すと、デフォルトの表示に戻すことができます。"
			}
		}
		switch-to-mgmt-mode: {
			name: "戦闘と管理モード"
			texts: {
				combat-mode: "<highlight>戦闘モード</highlight>は、マップを探索する時や敵と戦う時に使用します。"
				mgmt-mode: "<highlight>管理モード</highlight>は、街作りと管理の時に使用します。"
				switch: "<highlight>「Tab」</highlight>を押すと、モードが切り替わり、管理モードが表示されます。"
			}
			objectives: {
				management-mode: "管理モードへの切り替え"
			}
		}
		build-houses: {
			name: "建物"
			texts: {
				intro: "街の人口を増やすには、労働者が住むための<highlight>家をいくつか建てます</highlight>。"
				build: "建築メニューから<highlight>「家」</highlight>ボタンを選択し、地図上をクリックして配置してください。"
			}
			objectives: {
				buildhouses: "{0} x{1}を建てます"
			}
		}
		build-rails: {
			name: "自動配布"
			texts: {
				intro: "家には常に食料が必要です。ドリームエンジンの資源は、ベルトコンベアーのように動く<highlight>自動レールシステム</highlight>によって運ばれてきます。"
				build: "レールを敷くには、インフラストラクチャーカテゴリーからレールを選択し、リソースの移動方向にクリック＆ドラッグします。"
				access-points: "建物は、アクセスポイントからリソースを受け送りします。建物からレールをドラッグして出入り口スロットを設置してください。"
			}
			objectives: {
				sendfood: "シティコアから食料を送るための出口を設置してください。"
				connect-houses: "家の入り口を作成してください。"
				housesactive: "レールを繋いで、二軒の家に食料を届けてください。"
			}
		}
		equip-repairkit: {
			name: "インベントリと装置"
			texts: {
				intro: "危険な場所を探索する前、タイニーがダメージを受けたときのために<highlight>リペアキット</highlight>をいくつか装備しておくとよいでしょう。"
				grab: "建物のメニューを開くには、<highlight>管理モード</highlight>の状態で<highlight>左クリック</highlight>してください。"
				equip: "次に、リペアキットをクイックスロットに追加します。<highlight>「I」</highlight>を押して、キャラクター画面を開きます。"
			}
			objectives: {
				collectrepairkit: "シティコアにある倉庫からリペアキットを持ってきてください。"
				equiprepairkit: "クイックバーにリペアキットを追加してください。"
			}
		}
		grab-items: {
			name: "アイテムの転送"
			texts: {
				grab: "これは建物のメニューです。左側にはタイニーのインベントリ、右側には建物の在庫情報が表示されています。\n\n<highlight>「Shift」</highlight>を押しながら、<highlight>修理キット</highlight>アイコンを<highlight>クリック</highlight>すると、スタック全体をつかむことができます。"
			}
		}
		quickbar: {
			name: "クイックバーへの割り当て"
			texts: {
				assign: "キャラクターメニューにある<highlight>空きスロット</highlight>をクリックし、そのスロットに割り当てたいアイテムを選択します。\n\n割り当てられたアイテムは、戦闘モード中に対応するキーボードショートカットを押すことによって使用できます。"
			}
		}
		tiny-combat: {
			name: "ドリームプレイグとの戦闘"
			texts: {
				intro: "探索中のタイニーはドリームプレイグ(Drep)に遭遇します。タイニーには付け替え可能な射撃武器と近距離武器が装備されており、敵対生物から身を守ることができます。"
				attack: "タイニーの近距離攻撃は<highlight>マウスの左ボタン</highlight>で、遠距離攻撃は<highlight>マウスの右ボタン</highlight>で行うことができます。"
				tips: "長押しで連続攻撃します。<highlight>TAB</highlight>を押して戦闘モードへの切り替えを忘れないください。"
			}
			objectives: {
				combatmode: "戦闘モードへの切り替え"
				meleeattack: "近接武器による攻撃"
				rangedattack: "射撃武器による攻撃"
			}
		}
		collect-bloodwood: {
			name: "ハーベスター"
			texts: {
				intro: "リソースを集めてみましょう。ミニマップに表示されている街の周辺を探索し、<highlight>ブラッドウッド</highlight>というリソースノードを探してください。"
				build: "ハーベスターを作るには、管理モードに切り替え、<highlight>リソースをクリック</highlight>してその画面を開き、<highlight>ブラッドウッドカッター</highlight>ボタンをクリックします。"
			}
			objectives: {
				findwood: "血の木材を探す"
				gatherwood: "{0}を作る"
			}
		}
		build-warper: {
			name: "製作"
			texts: {
				intro: "今、丸太を集めていますが、それを使う前に<highlight>板</highlight>に精製して<highlight>倉庫</highlight>に運ぶ必要があります。丸太などの原材料は、精製されたものであれば持ち運ぶことができますが、飛び立つ時は持ち運ぶことができません。"
				buildwoodwarper: "<highlight>ウッドワーパー</highlight>で丸太を板に加工することができます。ウッドワーパーは<highlight>パワーエリア</highlight>内にある必要があるので、街の近くに建てるとよいでしょう。"
				freecamera: "管理モードでは、「Space」を押すとゲームが一時停止し、「F」を押すとフリーカメラが切り替わります。ゲームが一時停止している間、タイニーを動かさずにマップのどこででも建築することができます。"
			}
			objectives: {
				buildwoodwarper: "{0} x {1}を作り、それらに丸太ん棒を供給する"
			}
		}
		speedup: {
			name: "スピードアップ"
			texts: {
				sendplanks: "では、レールをいくつか設置し、貯蓄用の板材をワーパーからシティコアまで送ってください。そして板材が生産されるのを待ちます。"
				speedup: "板材が届くのを待つ間、ゲームをスピードアップすることができます。レールを作った後、スピードアップボタン（デフォルト「＋」）を長押ししてください。"
			}
			objectives: {
				haveplanks: "{0} x{1}を集める"
			}
		}
		city-level1: {
			name: "都市のレベル"
			texts: {
				nodes: "探索の際、追加のリソースノードに注意を払ってください。リソースノードが減ると、生産速度が半減するので、より多くのノードを接続する必要があるかもしれません。"
				increase-pop: "では、<highlight>街の人口レベルを上げて</highlight>更にいくつかの建物をアンロックしましょう。街のレベルを上げるには、人口を増やさなければいけません。進行状況は画面上にあるHUDで確認することができます。"
			}
			objectives: {
				build-houses: "三軒の家に食料を供給してください。"
				city-level1: "人口が{1}に達する"
			}
		}
		craft-repairkit: {
			name: "工芸品"
			texts: {
				intro: "探索、採集、防衛をより効率的に行うには、より良い<highlight>装備</highlight>が必要です。新しい武器や防具を作る前に、研究を行う必要がありますが（詳細は後述）、すでに<highlight>リペアキットをいくつか</highlight>作成することができます。"
				craft: "<highlight>「C」</highlight> を押してクラフト画面を開き、リペアキットを選択してクラフトボタンをクリックします。先に板材を入手する必要があるかもしれません。"
			}
			objectives: {
				craftrepairkit: "{0}をつくる"
			}
		}
		produce-food-farms: {
			name: "食料生産 - 農業"
			texts: {
				farms: "次に、食料を見てみましょう。食料は無限にあるわけではありません。食料生産の最初のステップは、原料を栽培することです。<highlight>紫芋畑</highlight>をいくつか作れば問題ないでしょう。<highlight>「採集」</highlight>のカテゴリーで見つけることができます。"
				tesla: "パワーのカテゴリーにある<highlight>テスラタワー</highlight>を建てると、パワーエリアを拡大することができます。"
			}
			objectives: {
				buildtesla: "{0}を建ててください。"
				buildfarm: "街の近くに紫芋畑を作ってください。"
			}
		}
		produce-food-process: {
			name: "食料生産 - 加工"
			texts: {
				intro: "<highlight>食品工場</highlight>と<highlight>畑から紫芋</highlight>を輸送するレールを設置し、生産した食品を<highlight>シティコア</highlight>の倉庫に送ってください。"
				more-food: "人口増加と共に、食料生産を増やさなければいけません。食品工場の効率をフルに発揮させるために、より多くの農場を建設することができます。建物の詳細確認から生産UIでサイクルごとの出入り量を見ることができます。"
			}
			objectives: {
				buildfoodplant: "{0}を建ててください。"
				producefood: "{0}に紫芋を供給してください。"
				sendfood: "食品を倉庫へ送ってください。"
			}
		}
		power-flux: {
			name: "パワーとフラックス"
			texts: {
				intro: "都市を維持するためには、食料や木材以外にも必要なものがあります。<highlight>パワー</highlight>と<highlight>フラックス</highlight>を大量に生産する必要があります。"
				buildflux: "一部のフラックスは家で作れますが、大量生産にはフラックスバットが必要です。<highlight>街の外れ</highlight>に設置してください。基本的なレシピは原料が必須ではないので、配置場所を心配しなくても大丈夫です。"
				buildpower: "新しい建物を建てる際、電力は必要ではありませんが、既存の建物の維持には欠かせません。発電量は常にプラスであることに気をつけてください。電力は<highlight>発電機</highlight>から得ることができます。フラックス同様、基本レシピに原料はいりませんが、近づけて建てることはできません。"
			}
			objectives: {
				buildflux: "都市の近くに{0}×{1}を建てる"
				buildpower: "都市の近くに{0}×{1}を建てる"
			}
		}
		move-objects: {
			name: "シティエリアの管理"
			texts: {
				intro: "探検の準備はもう出来たのでしょう。その前に、自分の都市の<highlight>内側</highlight>や<highlight>外側</highlight>に建物を建てるというコアコンセプトを理解する必要があります。"
				flying: "都市は<highlight>飛ぶ</highlight>ことができるので、中に建てる建物を<highlight>持ち運ぶことができます</highlight>。しかし、スペースや<highlight>持ち運びの重さ</highlight>には制限があるので、それらを拡大することができるが、建てるものには優先順位をつける必要もあります。基本的な建物のほとんどは安く、しかし多くのスペースを占めているため、外に建てて、飛び立つ前にそれらを取り壊すのがお薦めです。"
				longrun: "しかし、長い目で見れば、<highlight>できるだけ多くの産業を持ち運べたいと思うでしょう</highlight>。そこで、より高価な建物や、基本的な建物の<highlight>アップグレード版</highlight>を都市の中に建てるのがお勧めです。"
				moving: "ほとんどの建物は、移動させることができます。建物を移動するには、管理モードで<highlight>「M」</highlight>を押し、移動したい建物をクリックして新しい位置に置きます。"
			}
			objectives: {
				movebuilding: "建物の移動"
			}
		}
		tutorial-end: {
			name: "チュートリアルの終了"
			texts: {
				end1: "よくできました！これでチュートリアルは終わりです。これらは最も基本的な操作で、学ぶべきことはまだまだたくさんあります。研究、探検、設備のアップグレード、自動ハーベスターなど、その他の機能や仕組みについては、その都度説明します。"
				end2: "最初の目標は、<highlight>人口を増やして</highlight> <highlight>研究所</highlight>をアンロックすることです。このゲームでの最終目標は、<highlight>永住権</highlight>を獲得する方法を見出すことです。"
				end3: "<highlight>精製</highlight>できる<highlight>資源</highlight>をできるだけ多く<highlight>収集</highlight> し、ドリームプレイグに防御を突破される前に、飛び立つ準備をしてください。"
				end4: "ご意見、ご感想がありましたら、意見送信ボタンをご利用いただくか、ディスコード（タイトル画面にリンクがあります）にご参加ください。幸運を祈ります！"
			}
		}
		researchlab-unlocked: {
			name: "研究ラボ"
			texts: {
				build: "人口が増加し、<highlight>研究所</highlight>がアンロックされました。研究所を建て、技術を研究し、新しい建物や装備、その他のボーナスをアンロックしましょう。"
				research: "<highlight>「R」</highlight>を押して<highlight>研究画面</highlight>を開き、研究する技術を選択してください。"
				materials: "研究ラボが知識を生産するためには、<highlight>定期的に必要な材料</highlight>をラボに供給する必要があります。また、ラボと接触するときに生産ウィジェットに表示されます。"
			}
			objectives: {
				buildlab: "{0}を建てる。"
				research-selected: "研究する技術を選んでください。"
				activatelab: "{0} にリソースを供給する。"
			}
		}
		research-screen: {
			name: "研究画面"
			texts: {
				desc: "この画面では、研究の計画と設定を行うことができます。<highlight>知識ポイント</highlight>を消費することによって、研究を完成させ、新しい要素がアンロックされます。\n\nアンロックにマウスカーソルを合わせると、その詳細が表示されます。"
				desc2: "どれか研究項目を<highlight>クリック</highlight>し、目標を設定してください。<highlight>シフト+クリック</highlight>で研究対象を列の最後に追加することができます。\n\n研究目標が設定されると、研究所は知識作成を開始します。知識ポイントは完了するまで、列最初の研究対象に割り当てられます。"
			}
		}
		expand-city: {
			name: "拡張"
			texts: {
				desc: "住宅や生産施設のためのスペースを確保するために、都市エリアを拡張してください。"
				desc2: "<highlight>建築メニュー</highlight>の<highlight>「インフラ」</highlight>カテゴリから<highlight>「都市拡張」</highlight>を選択し、マップ上で購入したいものを選んでください。"
			}
		}
		missing-workers: {
			name: "労働者"
			texts: {
				desc: "建物の数に対して労働者の数が足りません。あなたの人口は、あなたの都市とその産業を運営するための労働者としても機能します。<highlight>労働者はシティコア</highlight>で作られますが、無料の<highlight>住宅</highlight>が利用できる場合に限ります。"
				desc2: "最大人口を増やすには、<highlight>家を建ててアップグレード<highlight>し、常に食料を供給できるようにしてください。電力や食料がない<highlight>家</highlight>は、生活空間として提供できせん。"
			}
		}
		mini-raids: {
			name: "彷徨うドリームプレイグ"
			texts: {
				desc: "街が地上にある限り、攻撃されやすい場合が多いです。ほとんどのドリームプレイグは、近づかない限り休眠状態ですが、時折小さな集団が街の近くに迷い込み、<highlight>警告なしに襲ってくる</highlight>ことがあります。"
				desc2: "タイニーならこれらの小さい集団を簡単に退治できますが、一度にどこにでも行けるわけではありません。また、これらの生物は露出している建物をすぐに破壊してしまいます。これを防ぐには、<highlight>壁や門</highlight>で街のすべての入り口を塞ぎ、<highlight>タレット</highlight>で守ることです。"
			}
			objectives: {
				build-turret: "{0} x{1}を建てます"
				build-wall: "{0} x{1}を建てます"
			}
		}
		attack-warning: {
			name: "ドレップレイド"
			texts: {
				desc: "街は時々それを破壊しようとするドリームプレイグに遭遇することがあります。これらの<highlight>襲撃</highlight>は、その辺をうろついているものよりも危険で、複数波にわたって襲ってきます。"
				desc2: "<highlight>ミニマップ</highlight>でレイドを追跡することができますが、レイドの方向から建物を守るために、いくつかの防衛手段を構築することを強くお勧めします。\n\n<highlight>タレット</highlight>は強力なパワーがありますが、あまり大きなダメージには耐えられないので、<highlight>壁</highlight>を設置してください。"
				desc3: "木製のタレットは発射速度が遅いが、<highlight>爆発的なエリアダメージ</highlight>を与えます。弱い敵の群れを攻撃するには最適な武器ですが、強い敵を倒すのにも不可欠なものです。\n\n都市を組み立てるときにタレットを移動させることができますが、それはレイドがいない場合に限られます。"
			}
		}
		taking-off: {
			name: "離陸"
			texts: {
				desc: "あなたの都市が動かない限り、ドレップの襲撃はますます激しくなるので、HUDで現在の<highlight>危険度</highlight>を確認してください。"
				desc2: "彼らが手強くなってきたと感じたら、今すぐ飛び立ってより安全な場所を見つけて着陸するべきです。<highlight>HUD内の発射ボタン</highlight>をクリックすると、離陸準備が開始します。\nエンジンが温まるまで<highlight>時間がかかります<highlight>ので、<highlight>あまり待たないように</highlight>しないと、ドレップが襲ってきます。"
				desc3: "外部の建物をぶち壊して資源の一部を取り戻すか、スペースと積載重量に余裕があれば都市内に移動させることもよい選択です。"
				desc4: "また、丸太ん棒のような精製されてない原材料は重くて運べにくいので、置いていかれてしまいます。だから、できれば精製してから出発しましょう。それと最も重要なことですが、タイマーが切れるときにタイニーが都市にいることを確認することです。"
			}
		}
		infrastructure-upgrades: {
			name: "インフラのアップグレード"
			texts: {
				desc: "<highlight>インフラストラクチャーをアップグレードする</highlight>ための材料を生産する工場を作ることができました。インフラをアップグレードすることで、ボーナスや能力が与えます。"
				desc2: "アップグレード材料を充分に集め、<highlight>「K」</highlight>を押すと、設備画面が表示され、アップグレードを購入することができます。"
			}
			objectives: {
				produce-parts: "{0} x {1}を作成してください。"
				purchase-upgrade: "設備アップグレードを購入してください。"
			}
		}
		infrastructure-window: {
			name: "インフラストラクチャー画面"
			texts: {
				desc: "これはインフラストラクチャー画面です。ここで、<highlight>アップグレード材料</highlight>を使ってインフラをアップグレードし、永続的なメリットを受けることができます。"
				desc2: "アップグレードポイントを購入したい方は、<highlight>アップグレード</highlight>ボタンをクリックしてください。その後、インフラのさまざまな<highlight>エリア</highlight>をクリックしてアップグレードすることができます。インフラの各エリアのレベルに達すると、パッシブなボーナスが得られます。\n\nアップグレードした後は、ポイントを各エリアの特別な<highlight>特典</highlight>に割り当てることができるし、しかもボーナスや能力も得られます。"
			}
		}
		multiple-productions: {
			name: "生産の切り替え"
			texts: {
				desc: "一部の建物では、追加のレシピがアンロックされた後、複数のレシピを生産することができます。\n\n<highlight>生産レシピの名前をクリックする</highlight>と、別のレシピを選択することができます。"
				desc2: "一部のレシピは、その建物で生産する前に、特定のアドオンを構築する必要があります。"
			}
		}
		rail-crossing: {
			name: "レールの交差"
			texts: {
				desc: "レールは、2本の線路を交差させても渋滞を起こさないよう、空隙技術を採用しています。"
				desc2: "レールの一部をドラッグして、他のレールの一部と交差するように組むと、自動的に交差点ができます。"
			}
			objectives: {
				build-crossing: "レールの交差点を組んでください。"
			}
		}
		drep-crafting: {
			name: "ドリームプレイグの加工"
			texts: {
				desc: "ドリームプレイグの残骸を貴重なリソースに精製する技術の研究に成功しました。クラフト画面のリソースタブを使用してください。"
			}
			objectives: {
				craft: "ドリームプレイグ残骸の精製"
			}
		}
		splitter-unlocked: {
			name: "ソーター"
			texts: {
				desc: "ソーターの研究が完了しました。この装置をレールの上に設置することで、そこに入ったアイテムを、形状に従って3つの出口に振り分けることができます。"
				desc2: "ソーターを設置したあと、ユーザーインターフェースを開いて、どのアイテムがどの出口に入るかを設定します。"
			}
		}
		expeditioncenter-unlocked: {
			name: "エクスペディションセンター"
			texts: {
				desc: "これでエクスペディションセンターを建てることができます。このユニークな建物でエクスペディションを選択し、開始することができ、付近の地域で物資と古代技術を探索することができます。"
				desc2: "探検センターを設置し、探検の派遣についてもっと知ることができます。"
			}
		}
		expeditions: {
			name: "エクスペディション"
			texts: {
				desc: "これはエクスペディション選択画面です。各マップには、バイオームとマップの難易度に応じて、異なるエクスペディションオプションがあります。エクスペディションはコスト、準備期間、エクスペディション時間と潜在的報酬によって、それぞれ異なります。\n\nエクスペディションを選択する前に、これらの情報をすべて確認することができます。"
				desc2: "各エクスペディションには二段階あります：一つは<highlight>準備</highlight>段階、ともう一つは<highlight>活動</highlight>段階です。\n\nエクスペディションを選択すると、<highlight>前払い費がすぐに支払われ</highlight>、準備段階が始まります。準備段階中、エクスペディションセンターでは<highlight>選択したエクスペディションに応じてアップキープ</highlight>が行われます。\n\n準備が完了すると、エクスペディションが開始され、エクスペディション隊員（ワーカー）以外のアップキープは停止します。"
				desc3: "エクスペディションに成功すると、隊員はワーカープールに戻り、<highlight>報酬を選択する</highlight>ことができます。\n\nエクスペディションの戦利品には、他では見つからないような<highlight>リソース</highlight>、<highlight>燃料</highlight>、その他 <highlight>ユニークなアイテムとボーナス</highlight>が含まれているかもしれません。"
			}
		}
		archeology-unlocked: {
			name: "考古学プロジェクト"
			texts: {
				desc: "考古学によって、旧世界の技術に基づいた本格的プロジェクトを始動し、強力な永久ボーナルをもらうことができます。"
				desc2: "廃墟をスクラップすることで、新プロジェクトをアンロックすることができます。これらを完了させるには、まず考古学者を研究し、育てなければなりません。"
			}
		}
		archeology: {
			name: "考古学プロジェクト"
			texts: {
				desc: "考古学プロジェクトを選択し、作業を開始します。異なるプロジェクトには異なるコストが設定されており、作業中は継続的に考古学者に供給しなければなりません。\n\n完了すれば、ボーナスは永久的なものになり、それ以上のリソースを消耗することはありません。"
				desc2: "複数の考古学者に必要な素材が与えられた場合、彼らは同じプロジェクトに参加しなければなりません。"
				desc3: "廃墟をスクラップすると、新しい考古学プロジェクトが見つかるかもしれません。"
			}
		}
		council: {
			name: "市議会"
			texts: {
				desc: "都市が一定の規模に発展すると、市民は市議会議員を選出します。選挙の度に、各派閥から一人ずつ、計三人の議員が選ばれます。\n\nこの中の誰を議長に選ぶかは、監督者であるあなた次第です。\n\nこのウィンドウを閉じる前に、議長を選ばなければいけません。"
				desc2: "各議員にはそれぞれ異なる <highlight>ボーナスとペナルティ</highlight>があり、その議員を新議長に選んだ場合適用され、次の選挙まで有効です。\n\nその議員の派閥への<highlight>影響力を得る</highlight>ことができますが、それと同時に残りの二つの派閥への <highlight>影響力を失う</highlight>ことになります。"
				desc3: "左側には、各派閥との影響力が表示されています。その<highlight>影響力</highlight>がある程度高くなったり低くなったりすると、その派閥特有の<highlight>ボーナスやペナルティ</highlight>を得ることになります。\n\n影響力バーにマウスを乗せると、必要な影響力レベルとその効果が表示されます。"
			}
		}
		resource-elevators: {
			name: "自動ハーベスター"
			texts: {
				desc: "リソースドロップオフの研究により、ハーベスターは<highlight>自動的に資源を</highlight>新しい建物に送ることができるようになりました。"
				desc2: "ドロップオフした建物ごとに、どの資源を受け取るべきかを設定することができます。そして収穫者はどのレールからも提供を得られない時でも、常に資源を必要とする最も近いドロップオフした建物にカートを送るようにできます。"
				desc3: "ハーベスターのカートは街中を移動することができないため、街の外れか辺境にドロップを設置しなければいけません。"
			}
		}
		exporter: {
			name: "リソースパッカー"
			texts: {
				desc: "リソースパッカーは、自動ハーベスターのように、近くのドロップオフに材料を送ります。パッカーは、原材料だけでなく、<highlight>あらゆるリソース</highlight>を送ることができます。"
				desc2: "レールでパッカーに材料を供給し、その材料を受け取るためのドロップオフを設定します。"
			}
		}
		gamepedia: {
			name: "ドリームアーカイブス"
			texts: {
				desc: "新しいオプションをアンロックすると、<highlight>ドリームアーカイブス</highlight>でその情報を見ることができます。アーカイブを開くには<highlight>「H」</highlight>を押してください。"
			}
		}
		carrycapacity: {
			name: "重量と航続力"
			texts: {
				desc: "あなたの都市は重くなっています。建物を建てるたびに都市の重さが増えていき、航続力を超えてしまうと、離陸できなくなってしまいます。"
				desc2: "エンジンを作ったりアップグレードしたりすることで、積載量を増やすことができます（研究大事）。"
				desc3: "また、新しい建物を建てるのではなく、現在所有している建物をアップグレードすることで重さを減らすことができますし、都市の外を強化することもできます。"
			}
		}
		overweight-takeoff: {
			name: "テイクオフ中のオーバーウェイト"
			texts: {
				desc: "テイクオフ充電中に街の電力が負荷を超えました。\n\n充電は現在<highlight>一時停止</highlight>となっていますが、次の数秒間<highlight>街のウェイトバランスをとる</highlight>ことができれば、充電は再び始まります。しかし、時間がかかり過ぎると、全ての進度が失われ、充電をやり直さなければなりません。"
			}
		}
		low-health: {
			name: "HPが低い"
			texts: {
				desc: "タイニーのHPが減ってきました。HPはゆっくりと<highlight>上がっていきます</highlight>が、クイックバーから<highlight>修理キット</highlight>を割り当てて使用することもできます。"
				desc2: "大きなダメージを受けると<highlight>緊急テレポート</highlight>が作動し、あなたを都市へ送りますが、<highlight>貴重な時間と資源</highlight>を失うことになります。\n\nなるべくタイニーをいい状態に維持してください。"
			}
		}
		armored-enemies: {
			name: "装甲した敵"
			texts: {
				desc: "大型生物の中には<highlight>装甲済み</highlight>とみなされるものがあります。<highlight>木製タレット</highlight>はこれらに対して効果が少なく、<highlight>ダメージが軽減</highlight>します。"
				desc2: "防御用建物をアップグレードし、より良い対策ができるようにしましょう。万が一状況が悪化した場合は、準備が整うまで迷わず飛び去ってください。"
			}
			objectives: {
				build-turret: "{0}を建ててください。"
			}
		}
		destination-select: {
			name: "目的地選択"
			texts: {
				desc: "おめでとう！あなたの都市が初めて<highlight>飛び</highlight>ました。\n\nこの画面では、次に着地する場所を選ぶことができます。"
				desc2: "次の着地点は慎重に選んでください。あなたの選択は、<highlight>敵の強さ</highlight>、どの<highlight>資源がマップ上にあるか</highlight>を決めます。"
				desc3: "表示されるオプションは、現在の<highlight>世界侵入のレベル</highlight>（画面左上に表示されています）によって異なります。"
				desc4: "どのオプションも気に入らない場合は、<highlight>他の場所へ</highlight>ボタンをクリックして、多少の燃料を犠牲にしても選択肢を更新することができます。"
			}
		}
		abilities: {
			name: "アクティブアビリティ"
			texts: {
				desc: "おめでとう！タイニーの最初の<highlight>アクティブアビリティ</highlight>をアンロックしました。アクティブアビリティは修理キットや他の消耗品のように使うことができますが、使用するのに資源を必要としません。"
				desc2: "消耗品のように、アビリティは<highlight>クイックバー</highlight>に割り当てることができますが、しかし、ほとんどのアビリティには<highlight>クールダウン</highlight>が付き、使用回数には制限があります。"
			}
		}
		passive-income: {
			name: "パッシブインカム"
			texts: {
				desc: "パッシブインカムボーナスを獲得しました。このボーナスは指定されたリソースから定期的収入を得ることができます。"
				desc2: "これらのリソースは指定されたドロップオフに預けられます。そうでない場合は、シティコアに預けられます。"
			}
		}
		misc-items: {
			name: "使用可能なアイテム"
			texts: {
				desc: "あなたは使用可能なアイテムを手に入れました。このアイテムを使用するには、インベントリを開いて、アイテムを右クリックしてください。これらのアイテムは、戦闘中に使用するものではないため、クイックバーに割り当てることはできません。"
			}
		}
		upgrade-layer: {
			name: "アップグレードレイヤー"
			texts: {
				desc: "管理モードでは、ミニマップの左にあるボタンを使って、<highlight>「アップグレードレイヤー」</highlight>を有効にすることができます。"
				desc2: "その状態では、すべての建物に<highlight>現在のレベル</highlight>のアイコンが表示され、ゲームビューから直接その建物を<highlight>アップグレード</highlight>するボタンが表示されます。このビューは、経済を管理したり、建物をアップグレードするのに非常に便利です。"
				desc3: "他の管理レイヤーも用意されており、そのボタンにカーソルを合わせると詳細が表示されます。"
			}
		}
		onoff-tool: {
			name: "オン/オフツール"
			texts: {
				desc: "管理モードでは、<highlight>「オン/オフツール」</highlight>ボタン（デフォルトではショートカット「O」）を使って、ゲームビューから直接、建物を有効化または無効化することができます。"
			}
		}
		rebuild-debris: {
			name: "瓦礫＆再建"
			texts: {
				desc: "ドリームプレイグによって一部の建物が破壊されました。壊された建物には瓦礫が残りますが、それを使って元あった建物を確認し建て直すことができます。"
				desc2: "再建は、全てのアップグレード、アドオン、出入り口を含む建物を修復します。費用は一から建てるのと同じですが、一回のクリックで全てを修復することがきでます。"
				desc3: "修正/再建ツール（デフォルトキー「L」）、または瓦礫をクリックして建物情報画面から再建することができます。"
			}
		}
		sit-city-info: {
			name: "都市情報"
			texts: {
				desc: "HUD内の都市名をクリックすると、都市情報ウィンドウが表示されます。このウィンドウでは、現在の着陸帯の情報も表示されます。"
			}
		}
		teslacrats-production: {
			name: "資源の複製"
			texts: {
				desc: "あなたは今、資源の複製ができる、テスラクラッツのユニークな技術を研究しました。資源を複製するには、まずレシピに必要な一定量を入手しなければなりません。続いてクラフトインターフェースを開き、「資源」のタブで作業をします。"
				desc2: "作業に使用された機械は、使うたびに劣化していくため、価格は複製ごとに上がります。機械を使用しないとき、また新しい目的地へ向かうときには、その価格がゆっくりと元に戻ります。"
			}
		}
		raid-spawners: {
			name: "リフト"
			texts: {
				desc: "ナイトメアリフトを発見しました。レイド中にドリームプレイグが発生する可能性がある場所の一つです。"
				desc2: "リフトは不安定なため、その付近に建物を建てることはできません。"
			}
		}
	}
}