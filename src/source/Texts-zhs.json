		story-repair-informationstorage: {
			name: "探索幻魇"
			texts: {
				desc: "信息存储设备可提供幻魇的相关信息。"
			}
			dialogue: {
				before1: "我们的探索队回来了，监察官。研究中心的状况比我们预想的还要糟糕，建筑已经所剩无几。"
				before2: "他们确实发现了一些东西，似乎存储了一些研究信息。在确定之前我们必须修复设备。"
			}
			objectives: {
				repair-storage: "制造{0}"
			}
		}
		story-drepattack: {
			name: "已搁浅"
			texts: {
				desc: "信息存储设备正在吸引幻魇，导致城市丧失飞行能力。"
			}
			dialogue: {
				before1: "监察官，我们修复了这个装置。它确实存有一些信息，但同时也在启动一些奇怪的东西，干扰我们的梦幻科技。"
				before2: "监察官，有紧急情况！侦查员刚刚来报，有一大批幻魇正向城市赶来，而这个装置正在干扰引擎，让城市无法飞行。"
				before3: "监察官，请去检查城防，我去接触装置。"
			}
			objectives: {
				defeat-attack: "捍卫城市"
			}
		}
		story-dreamguard-fly: {
			name: "梦幻卫士"
			texts: {
				desc: "你了解到一个古老的组织-梦幻卫士。"
			}
			dialogue: {
				before1: "一切都结束了，但我们不得不销毁这个装置。销毁之前我们设法从中获取了一些信息。"
				before2: "我们发现了关于古人黑暗时代的信息，他们称之为 \"噩梦年代\"。那是一个古人使用可怕的梦幻科技武器互相开战的时代。"
				before3: "战争结后，特维斯特几乎被摧毁。据我们所知，战争最终以一个名为梦幻卫士的组织的胜利而告终。"
				before4: "他们冷酷无情，战争胜利后控制了整个特维斯特。"
				before5: "没有找到有关幻魇起源的信息。也许是梦幻卫士使用的某种武器？"
				before6: "如果能找到他们基地的遗迹，也许能了解到更多信息。有情报显示在灰陨山脉有一个基地。"
				before7: "那个地区很热。如果没有适当的保护措施，我们的城市将无法承受。"
				before8: "我们可以在城市核心安装一个热盾用来保护整个城市，但首先必须研究一下。"
			}
			objectives: {
				build-heatshield: "在你的{0}建造{3}"
				reach-lava: "飞往{0}"
			}
		}
