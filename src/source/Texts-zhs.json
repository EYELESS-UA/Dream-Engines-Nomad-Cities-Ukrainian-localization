	tribes: {
		scavengers: {
			name: "拾荒领主"
			desc: "拾荒领主是变废为宝的大师级人物。被其他部落认为是古代垃圾和普通蓝色盒子的东西，他们认为是宝藏。他们在寻找和利用每一块废铁方面拥有十分专业的知识，而事实证明这对于恢复和维护古老的游牧城市来说非常有用。"
		}
		dreamweavers: {
			name: "筑梦者"
			desc: "即便并不能完全理解这种古代技术的原理，但筑梦者十分擅长操纵梦幻科技。他们特别擅长生产幻能，并且能够使用更多的造物机。\n\n然而这些能力是有代价的。他们犹如着魔般沉迷在梦幻领域中进行各种实验，这使得幻魇群袭因他们的存在而格外躁动。"
			unlocktext: "解锁条件：与任何其他部落交往时拥有3000幻能"
		}
		electric: {
			name: "特斯拉狂人"
			desc: "他们对电能的使用出神入化，他们独有的工艺配方可以仅仅只靠电力就能复制资源。特斯拉狂人的主要缺点是，他们看不起廉价能源，因此原始发电的效率非常低。"
			unlocktext: "解锁要求：每回合的总发电量（消耗前）达到600功率"
		}
		builders: {
			name: "河狸"
			desc: "河狸部落以其伟大的建筑工程而闻名。他们可以轻而易举地快速扩建城市，还可以用更少的资源升级建筑。不过他们可舍不得扔下他们宝贵的作品，所以大多数建筑都是在城市内部建造。对于讨厌浪费和抛弃建筑的玩家来说，这是一个完美的部落。"
			unlocktext: "解锁要求：在一局游戏中扩展您的城市五次。"
		}
		explorers: {
			name: "遗迹勘探者"
			desc: "遗迹勘探者是一个探险家部落，他们相信救赎将来自过去。他们致力于与经验丰富且行动高效的探险队一起寻找和探索旧世界的废墟。它们在飞行时使用的燃料更少，而且小迪的移动速度更快。然而，他们的防御能力比大多数部落都弱，他们的研究速度也较慢。"
			unlocktext: "解锁条件：在一轮游戏中完成5次远征。"
		}
		gatherers: {
			name: "泰拉族"
			desc: "泰拉族部落（简称”泰拉“）是一个勤劳的民族，能够充分利用环境中的资源。他们擅长采集资源，能够在矿点资源耗尽之前收割尽可能多的资源，并且可在每张地图中寻得一处额外的随机（取决于等级）资源节点，不同于地图信息中所列出的其他资源类型。\n\n但是，他们不相信人造资源，所以他们无法使用造物机，而且他们提炼原始资源的速度也比较缓慢。"
			unlocktext: "解锁条件：在2颗骷髅及以上难度的地图中的所有资源节点上建造收割机。"
		}
		hunters: {
			name: "幻魇猎人"
			desc: "在幻魇群最初开始出现时，一个名为“幻魇猎人”的军事组织也随之浮现。数个世纪后，幻魇猎人的后裔仍然散布于世界各地，尽己所能地狩猎幻魇并利用它们的残骸存活。\n\n幻魇猎人擅长战斗，从倒下的幻魇中提取材料并找到其用途。他们将最优秀的工程师都投入到战斗中了，所以他们生产设施的效率不是很高。"
			unlocktext: "解锁条件：在一局游戏中与小迪杀死150个幻魇群。"
		}
		nomads: {
			name: "传说守护者"
			desc: "传说守护者是历史学家，是研究旧世界一切事物的专家。为了尽可能多地探访废墟，他们比其他部落更加游牧，并完善了高效的城市旅行，能够从远处发现这些废墟。他们不断插手旧世界的事情，导致幻魔更早地注意到了他们，并发动了猛烈的攻击。"
			unlocktext: "解锁方法：在一个游戏中与 接触10 个不同的废墟。"
		}
		doomed: {
			name: "厄运部落"
			desc: "有些人觉得他们被诅咒了。他们运气极差，很少能如愿以偿，一切对他们来说都难上加难。厄运部落就是这样一群人的集合体。\n\n幻魇会更加频繁地找上他们，他们会更容易身处敌对区域，资源匮乏导致他们在生活上更加艰难。此艰苦的生活让他们变得更加粗犷，对生存的要求也更低了。"
			unlocktext: "解锁方法：在威胁等级30或更高的的突袭中存活下来。"
		}
	}
