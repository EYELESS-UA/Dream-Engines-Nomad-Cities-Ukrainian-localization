		presets: {
			very-easy: {
				name: "休闲"
				desc: "此难度最适合对地图探索和建造更感兴趣的玩家。\n\n在此难度下，强袭等级不会增加，除非您主动飞到更高难度的地图。\n\n敌人仍然会攻击您的城市，但是威胁等级增加的速度要慢得多。如果您想完全取消突袭，您可以在下面的威胁难度设置中自定义选择。"
			}
			easy: {
				name: "一般"
				desc: "此难度下游戏节奏较慢、容错度更高，您可以在任何时候保存游戏进度，并且游戏中所有的敌人更弱。\n\n我们推荐新玩家，或者寻求轻松的游戏体验，但仍希望有一些时间压力和挑战的玩家选择此难度。"
			}
			beginner: {
				name: "初学者"
				desc: "此难度为新手推荐难度。\n\n此模式下游戏速度会稍稍放慢，游戏中的战斗较为容易，这将让您更好地熟悉游戏内容。\n\n在您经过几次尝试，逐渐熟悉游戏中独特的操作和系统后，我们推荐您切换至中等难度进行游戏。"
			}
			no-time-limit: {
				name: "从容不迫"
				desc: "接近于中等难度，但强袭等级不会自动增加。\n\n此模式下游戏压力显著降低，因为您可以在前往更高等级的地图之前，随意访问低等级地图。在每张地图中仍会存在时间压力，因为突袭和威胁等级会正常增加，但是飞至同样难度等级的新地图时会重置这些等级。"
			}
			economy-focus: {
				name: "经济挑战"
				desc: "此难度适合更喜欢在建筑和管理方面寻求挑战的玩家。\n\n此模式下的战斗难度接近于初学者难度，但资源更为稀有，建设成本也会增加。"
			}
			challenging: {
				name: "中等"
				desc: "此难度为游戏正常难度。\n\n推荐已经熟悉游戏中独特的系统和操作，准备好迎接真正挑战的玩家选择此难度。"
			}
			hard: {
				name: "困难"
				desc: "此难度适合喜欢挑战自我的玩家。\n\n地图中存在更多的敌人，威胁等级增长更快，给玩家带来更紧迫的时间压力。"
			}
			very-hard: {
				name: "幻魇群袭"
				desc: "最高难度等级。\n\n小迪的属性更弱，能找到的资源更少，建筑需要更多材料。强袭间隔时间比困难等级更短。\n\n请量力而行。"
			}
			custom: {
				name: "自定义"
				desc: ""
			}
		}
	}
	opening-story: {
		paragraph1: {
			text1: "特维斯特"
			text2: "曾经，这是一个充满奇迹和梦想的世界。"
			text3: "现在，这里成了噩梦之地。"
		}
		paragraph2: {
			text1: "随着一种超越现实的技术“梦幻科技”的出现，特维斯特成为了许多伟大而繁荣的帝国的家园。"
			text2: "至少，传说是这么记载的。"
		}
		paragraph3: {
			text1: "随后，幻魇降临。"
			text2: "无人知晓他们来自哪里。这些东西似乎直接来自他们的噩梦。"
			text3: "它们到处出现，让世界措手不及。"
			text4: "特维斯特人英勇奋战，但幻魇却无休无止，毫不留情。大城沦陷，帝国灭亡。"
		}
		paragraph4: {
			text1: "几个世纪后，特韦斯特本身变成了一个黑暗扭曲的星球。"
			text2: "仅存的一些特维斯特人以游牧部落的形式生存，从不扎根，也从不在同一个地方停留太久。在幻魇捕捉到他们的气息之前，不停迁徙。"
			text3: "您的故事从这里开始。"
		}
	}
