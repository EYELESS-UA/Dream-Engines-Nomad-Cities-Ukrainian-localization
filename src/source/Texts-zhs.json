			name: "探索危险实验"
			expedition-name: "梦幻卫士基地废墟"
			texts: {
				desc: "这个不寻常的实验可能与幻魇的出现有关。"
			}
			dialogue: {
				before1: "我们到了，监察官。组建一支探索队，了解更多有关厄运女士实验的信息吧。"
			}
			objectives: {
				perform-expedition: "完成探索：{0}"
			}
		}
		story-researchshield: {
			name: "实验物品"
			texts: {
				desc: "寻找一种长期的解决方案，以免受到幻魇的伤害。"
			}
			dialogue: {
				before1: "监察官，我们了解到了更多有关厄运女士和她的实验。她渴望权力。"
				before2: "她认为，进入梦境并利用波动改变现实世界只是冰山一角。如果能以实体形态进入梦境，她将变得无所不能。自然法则将不再适用，她可以在里面为所欲为。"
				before3: "她着了魔，在梦幻卫士的眼皮底下做实验，虽然最终她成功了，但她也失败了。"
				before4: "梦境是一个纯能量的地方。据我们所知，她的身体已经扭曲变形，并被梦境的纯能量压碎。"
				before5: "传说她的意识仍被困在梦境中，永远身处痛苦，无法回到我们的现实世界，因为她的肉体已经不存在了。"
				before6: "监察官，这还不是全部。我们以为梦境无人居住，但事实并非如此。她的实验数据显示，当她把肉体转移到梦境时，遇到了什么东西。"
				before7: "那里住着某种东西。当厄运女士进行实验时，它们意识到了我们这个现实世界的存在。"
				before8: "他们没有肉身，无法存在于我们的世界。但毁灭女神在我们的世界之间制造了一道裂缝。这些东西可以通过裂缝影响我们的世界。它们可以附身在生物身上，甚至是没有生命的物体上。"
				before9: "这就是幻魇。它们渴望来到这个物质世界，但它们所能做的只是占有物质。它们一直渴望着我们活生生的肉体。"
				before10: "它们开始出现在整个特维斯特。起初数量不多，但每当梦幻卫士摧毁一个巢穴，关闭一道裂缝，就会有更多的幻魇\n出现。"
				before11: "梦幻卫士不堪一击，城邦沦陷。特维斯特本身变化、扭曲，变成了我们今天所知的黑暗之地。"
				before12: "监察官，我们该如何是好。这座城市正在危害整个世界。如此大量的梦幻科技集中在一个地方，削弱了梦境之间的界限，扩大了裂缝。但这也是我们生存的唯一希望。"
				before13: "梦幻卫士通过实验发现了另一种物质。一种与梦境通量相斥的反梦境物质。希望这种物质能帮助他们对抗幻魇。"
				before14: "让我们继续探索吧。"
			}
			objectives: {
				perform-research: "调查{0}"
			}
		}
		story-buildshield: {
			name: "生存的代价"
			texts: {
				desc: "寻找一种长期的解决方案，以免受到幻魇的伤害。"
			}
			dialogue: {
				before1: "监察官，我们成功了。我们找到了可以源源不断制造反梦境物质的方法。"
				before2: "我们可以建造一种无效化屏障。因为古人无法建造这种屏障，所以每当他们进行反梦境实验时，幻魇就会摧毁他们的研究。"
				before3: "但是我们有这座城市可以继续前进，完成他们的使命。但这需要大量的资源和材料，而这些并不容易找到。"
				before4: "需要注意的是，监察官，屏障可以保护我们不受幻魇的伤害。他们无法影响里面的现实世界，附着的东西将会变成无生命的躯壳。"
				before5: "但我们的梦幻科技也无法使用。通量会产生惰性，我们可以存货下来，但也会被困在这里。"
				before6: "监察官，请做出选择吧。我们可以一直飞下去，对抗越来越多的幻魇，也可以建造并启动无效化屏障。"
				before7: "如果您选择建造屏障，请记住充能需要很长时间才能完成。在此期间将会吸引大量幻魇。"
				before8: "我们躲过了攻击，来到了较为安全的区域，但屏障非常重，引擎也需要冷却一段时间后才能再次飞行。我们的防御能力将经受考验。"
			}
			objectives: {
				build-shield: "建造 ：{0}"
				activate-shield: "存活下来，直到完成充能。"
			}
		}
	}
