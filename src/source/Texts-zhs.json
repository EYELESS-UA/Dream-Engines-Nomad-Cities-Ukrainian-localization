	missions: {
		dialogue-goals-format: "{0}\n\n<color=#99EEFF>目标\n{1}</color>"
		dialogue-goals-line: "• {0}"
		story-start: {
			name: "新希望"
			texts: {
				desc: "一座会飞的古城的出现，重新点燃了您们部落的希望。"
			}
			dialogue: {
				before1: "监察官，这太神奇了！真是古人的杰作。"
				before2: "他们称它为 \"游牧城\"，它还会飞！我们不知道他们为什么要弃城，一切似乎都还在运转。"
				before3: "监察官，这个城里有一个神通。是一个叫做“小迪”的机械巨人。这也许是古人开的一个玩笑。"
				before4: "它全副武装，我们可以用它来探索周围的环境，寻找资源，对抗幻魇。"
				before5: "也许是时来运转。我们可以在这里建立一个真正的家，无论何时被迫逃离，我们都可以带着它。"
				before6: "即将进入城市核心的监察室。在这里，您可以控制小迪和整个城市。您可以感受到旅程的开始。巨大的困难在等待着您，但同时也带来了新的希望。您开始熟悉小迪的控制，并向往建造一座像过去一样宏伟的城市。"
			}
			objectives: {
				complete-tutorial: "完成教学"
				city-level1: "达到人口数{1}"
			}
		}
		story-buildlab: {
			name: "研究"
			texts: {
				desc: "部落希望开展自己的研究，以改善这座城市。"
			}
			dialogue: {
				before1: "我们开了个好头，监察官。大家从来没有如此兴奋过。"
				before2: "我们可以在这里建设一座真正伟大的城市，但要想发展和保卫这座城市，我们需要自己进行研究。"
				before3: "这座城市的基础设施状况相对较好，但很老旧。真的很古老。也许我们可以研究一个生产零件的车间，用来升级基础设施。"
			}
			objectives: {
				city-level2: "达到人口数{1}"
				buildlab: "建造：{0}"
				unlockworkshop: "研究{0}"
			}
		}
		story-upgrade-core: {
			name: "城市核心"
			texts: {
				desc: "升级城市核心可以解决市民的生存问题。"
			}
			dialogue: {
				before1: "监察官，您现在可以建造一个车间来生产零件，从而升级城市的基础设施。"
				before2: "我们的科学家还为城市核心设计了一些升级方案。请升级核心，从而提高飞行能力和资源产量。"
				before3: "监察官，请记住，我们在一个地方呆得越久，幻魇的敌意就会越来越强。"
				before4: "当我们身处险境或找不到所需资源时，您可以将城市飞往新的地点。"
			}
			objectives: {
				upgrade-core2: "升级: {3}"
			}
		}
		story-build-expeditioncenter: {
			name: "远征中心"
			texts: {
				desc: "调查游牧城市的起源及其居民的遭遇。"
			}
			dialogue: {
				before1: "监察官，我在城市档案中发现了一些有趣的东西。我发现在沙漠某处有一个研究机构正在研究一个叫做'游牧人计划'的东西。"
				before2: "我相信这个设施就是游牧城市的源头。如果我们对它进行调查，也许就能知道居住在这里的古人的遭遇，以及是否还有其他类似的城市。"
				before3: "我还在寻找该设施的确切位置。与此同时，请研究并建造一个探索中心，以便组织派遣探索队。"
				before4: "监察官，请记住，我们在一个地方呆得越久，幻魇的敌意就会越来越强。当我们身处险境或找不到所需资源时，您可以将城市飞往新的地点。"
				before5: "探索中心的一些所需资源只有在沙漠地区才能找到。"
			}
			objectives: {
				build-expeditioncenter: "建造：{0}"
			}
		}
		story-cityorigin-fly: {
			name: "城市起源"
			texts: {
				desc: "调查游牧城市的起源及其居民的遭遇。"
			}
			dialogue: {
				before1: "监察官，我们好像找到了游牧人研究设施。它位于附近的一片沙漠中，危险等级为 2 级。"
				before2: "危险等级越高的地方，幻魇就越难对付。在飞往更危险的地区之前，请确保小迪装备齐全，城市防守严密。"
			}
			objectives: {
				reach-desert2: "飞往{1}-{0}个骷髅或更高的区域"
			}
		}
		story-cityorigin-expedition: {
			name: "探索城市起源"
			expedition-name: "游牧人研究设施"
			texts: {
				desc: "调查游牧城市的起源及其居民的遭遇。"
			}
			dialogue: {
				before1: "监察官，我们找到了，是游牧人研究设施。不是很远，您可以组织一支探索队去调查这些遗迹。"
			}
			objectives: {
				perform-expedition: "完成探索：{0}"
			}
		}
		story-dreamplagues-fly: {
			name: "幻魇"
			texts: {
				desc: "您需要了解更多有关幻魇的信息，以及对这座城市造成的影响。"
			}
			dialogue: {
				before1: "监察官，我们发现了一些东西 很... 令人不安。"
				before2: "游牧计划已被放弃。我们发现这是唯一一座建成的城市，而且从未有人居住过。"
				before3: "众所周知，梦幻科技是建立在我们的现实世界与梦境之间的联系之上。"
				before4: "我们睡着后，\"意识 \"或 \"灵魂 \"就会进入梦境充能。在那里自然法则不复存在。在梦中，一切皆有可能。"
				before5: "梦幻引擎可以进入梦境，汲取梦境的精华-\"通量\"。然后，梦幻引擎装置就会利用这些通量来扭曲我们物质世界的现实。"
				before6: "据我们所知，古人建造游牧城是为了躲避幻魇。但他们发现了一个副作用。"
				before7: "由于某种原因，城市导致事态恶化。噩梦裂缝在他们周围不断出现，幻魇也被吸引到城市中。"
				before8: "更糟糕的是，他们认为这种伤害是永久性的。由于风险太大，他们放弃了这个计划。"
				before9: "监察官，我们还不能放弃这座城市。也许古人错了。也许几个世纪过去后，一切都变了。我们不能再回到以前的那种生活方式了，我们会活不下去的。"
				before10: "在您做出决定之前，请让我们进一步调查。我们发现了另一个研究设施，一个研究幻魇的机构。"
				before11: "让我找找看，也许会有更多答案。"
			}
			objectives: {
				reach-tier3: "继续建设城市，直到找到研究设施。"
			}
		}
