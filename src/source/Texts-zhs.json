			name: "探索梦幻卫士"
			expedition-name: "被遗弃的梦幻卫士基地"
			texts: {
				desc: "你了解到一个古老的组织-梦幻卫士。"
			}
			dialogue: {
				before1: "梦幻卫士基地就在附近。派一支探索队吧，监察官。"
			}
			objectives: {
				perform-expedition: "完成探索：{0}"
			}
