						video: null
					}
					pause: {
						video: "pause-unpause"
					}
				}
				objectives: {
					hover-video: {
						class: "MissionObjectiveReflectionBased"
						method: "CheckHoverVideo"
					}
					unpause: {
						class: "MisisonObjectiveBasicControls"
						time: 0
					}
				}
				next: {
					movement: true
				}
			}

