{
	missions: {
		base: {
			default: {
				is-starting-mission: false
				display-color: "mission-tutorial"
			}

			tutorial: {
				parents: [ "missions.base.default" ]
				is-tutorial: true
			}

			popup-tutorial: {
				parents: [ "missions.base.tutorial" ]
				popup: true
			}

			situational-tutorial: {
				parents: [ "missions.base.tutorial" ]
				show-if-last-seen-earlier: 226
				situational: true
			}

			window-tutorial: {
				parents: [ "missions.base.popup-tutorial", "missions.base.situational-tutorial" ]
				auto-complete: true
			}
		}

		entity: {
			welcome: {
				is-starting-mission: true
				start-order: 2
				parents: [ "missions.base.popup-tutorial" ]
				auto-complete: true
				texts: {
					desc: true
					desc2: true
				}
				next: {
					images: true
				}
			}

			images: {
				parents: [ "missions.base.tutorial" ]
				texts: {
					intro: {
						video: null
					}
