			}
		}
		story-cityorigin-expedition: {
			name: "探索城市起源"
			expedition-name: "遊牧人研究設施"
			texts: {
				desc: "調查遊牧城市的起源及其居民的遭遇。"
			}
			dialogue: {
				before1: "監察官，我們找到了，是遊牧人研究設施。不是很遠，您可以組織一支探索隊去調查這些遺跡。"
			}
			objectives: {
				perform-expedition: "完成探索：{0}"
			}
		}
		story-dreamplagues-fly: {
			name: "幻魘"
			texts: {
				desc: "您需要瞭解更多有關幻魘的資訊，以及對這座城市造成的影響。"
			}
			dialogue: {
				before1: "監察官，我們發現了一些東西 很... 令人不安。"
				before2: "遊牧計畫已被放棄。我們發現這是唯一一座建成的城市，而且從未有人居住過。"
				before3: "眾所周知，夢幻科技是建立在我們的現實世界與夢境之間的聯繫之上。"
				before4: "我們睡著後，\"意識 \"或 \"靈魂 \"就會進入夢境充能。在那裏自然法則不復存在。在夢中，一切皆有可能。"
				before5: "夢幻引擎可以進入夢境，汲取夢境的精華-\"通量\"。然後，夢幻引擎裝置就會利用這些通量來扭曲我們物質世界的現實。"
				before6: "據我們所知，古人建造遊牧城是為了躲避幻魘。但他們發現了一個副作用。"
				before7: "由於某種原因，城市導致事態惡化。噩夢裂縫在他們周圍不斷出現，幻魘也被吸引到城市中。"
				before8: "更糟糕的是，他們認為這種傷害是永久性的。由於風險太大，他們放棄了這個計畫。"
				before9: "監察官，我們還不能放棄這座城市。也許古人錯了。也許幾個世紀過去後，一切都變了。我們不能再回到以前的那種生活方式了，我們會活不下去的。"
				before10: "在您做出決定之前，請讓我們進一步調查。我們發現了另一個研究設施，一個研究幻魘的機構。"
				before11: "讓我找找看，也許會有更多答案。"
			}
			objectives: {
				reach-tier3: "繼續建設城市，直到找到研究設施。"
			}
		}
