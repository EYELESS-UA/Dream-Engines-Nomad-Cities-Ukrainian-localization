		}
		narrator: {
			name: ""
		}
	}
	missions: {
		dialogue-goals-format: "{0}\n\n<color=#99EEFF>目標\n{1}</color>"
		dialogue-goals-line: "• {0}"
		story-start: {
			name: "新希望"
			texts: {
				desc: "一座會飛的古城的出現，重新點燃了您們部落的希望。"
			}
			dialogue: {
				before1: "監察官，這太神奇了！真是古人的傑作。"
				before2: "他們稱它為 \"遊牧城\"，它還會飛！我們不知道他們為什麼要棄城，一切似乎都還在運轉。"
				before3: "監察官，這個城裏有一個神通。是一個叫做“小迪”的機械巨人。這也許是古人開的一個玩笑。"
				before4: "它全副武裝，我們可以用它來探索周圍的環境，尋找資源，對抗幻魘。"
				before5: "也許是時來運轉。我們可以在這裏建立一個真正的家，無論何時被迫逃離，我們都可以帶著它。"
				before6: "即將進入城市核心的監察室。在這裏，您可以控制小迪和整個城市。您可以感受到旅程的開始。巨大的困難在等待著您，但同時也帶來了新的希望。您開始熟悉小迪的控制，並嚮往建造一座像過去一樣宏偉的城市。"
			}
			objectives: {
				complete-tutorial: "完成教學"
				city-level1: "達到人口數{1}"
			}
		}
		story-buildlab: {
			name: "研究"
			texts: {
				desc: "部落希望開展自己的研究，以改善這座城市。"
			}
			dialogue: {
				before1: "我們開了個好頭，監察官。大家從來沒有如此興奮過。"
				before2: "我們可以在這裏建設一座真正偉大的城市，但要想發展和保衛這座城市，我們需要自己進行研究。"
				before3: "這座城市的基礎設施狀況相對較好，但很老舊。真的很古老。也許我們可以研究一個生產零件的車間，用來升級基礎設施。"
			}
			objectives: {
				city-level2: "達到人口數{1}"
				buildlab: "建造：{0}"
				unlockworkshop: "研究{0}"
			}
		}
		story-upgrade-core: {
			name: "城市核心"
			texts: {
				desc: "升級城市核心可以解決市民的生存問題。"
			}
			dialogue: {
				before1: "監察官，您現在可以建造一個車間來生產零件，從而升級城市的基礎設施。"
				before2: "我們的科學家還為城市核心設計了一些升級方案。請升級核心，從而提高飛行能力和資源產量。"
				before3: "監察官，請記住，我們在一個地方呆得越久，幻魘的敵意就會越來越強。"
				before4: "當我們身處險境或找不到所需資源時，您可以將城市飛往新的地點。"
			}
			objectives: {
				upgrade-core2: "升級: {3}"
			}
		}
		story-build-expeditioncenter: {
			name: "遠征中心"
			texts: {
				desc: "調查遊牧城市的起源及其居民的遭遇。"
			}
			dialogue: {
				before1: "監察官，我在城市檔案中發現了一些有趣的東西。我發現在沙漠某處有一個研究機構正在研究一個叫做'遊牧人計畫'的東西。"
				before2: "我相信這個設施就是遊牧城市的源頭。如果我們對它進行調查，也許就能知道居住在這裏的古人的遭遇，以及是否還有其他類似的城市。"
				before3: "我還在尋找該設施的確切位置。與此同時，請研究並建造一個探索中心，以便組織派遣探索隊。"
				before4: "監察官，請記住，我們在一個地方呆得越久，幻魘的敵意就會越來越強。當我們身處險境或找不到所需資源時，您可以將城市飛往新的地點。"
				before5: "探索中心的一些所需資源只有在沙漠地區才能找到。"
			}
			objectives: {
				build-expeditioncenter: "建造：{0}"
			}
		}
		story-cityorigin-fly: {
			name: "城市起源"
			texts: {
				desc: "調查遊牧城市的起源及其居民的遭遇。"
			}
			dialogue: {
				before1: "監察官，我們好像找到了遊牧人研究設施。它位於附近的一片沙漠中，危險等級為 2 級。"
				before2: "危險等級越高的地方，幻魘就越難對付。在飛往更危險的地區之前，請確保小迪裝備齊全，城市防守嚴密。"
			}
			objectives: {
