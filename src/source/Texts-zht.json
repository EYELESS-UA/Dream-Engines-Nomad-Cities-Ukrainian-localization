		story-lady-doom-fly: {
			name: "危險的實驗"
			texts: {
				desc: "這個不尋常的實驗可能與幻魘的出現有關。"
			}
			dialogue: {
				before1: "監察官，我們瞭解到了很多有關夢幻衛士的資訊。我們錯了，他們根本不是征服者。"
				before2: "隨著特維斯特幾乎被摧毀，各國一致同意結束戰爭。他們簽署了夢幻衛士協議，同意限制夢幻科技的使用與研究。特別是夢幻科技武器被嚴格禁止。"
				before3: "夢幻衛士就是為了維護協議而成立的。他們在監管夢幻科技的使用方面確實冷酷無情，但在他們的維護下，特維斯特蒸蒸日上。"
				before4: "偉大的城邦拔地而起，人們過著幸福自由的生活。除了夢幻衛士本身，所有軍事行動都被視為非法，大量資源被投入到人們的福利建設中。"
				before5: "這樣和平而富裕的時代對我們來說就是一個夢。"
				before6: "幻魘在那個時期根本不存在。無論它們是什麼，都一定不是戰爭的產物。"
				before7: "我們還有另外一條線索。儘管當時生活美好，但犯罪仍然存在。貪婪和權力欲望仍然佔據著一些人的內心。"
				before8: "這裏提到了一個這樣的罪犯，她是一個瘋狂的科學家，只知道她叫 \"厄運女士\"。她進行了非法的夢幻科技實驗，並設法躲過了夢幻衛士的追捕。"
				before9: "實驗的具體情況還不得而知。但我們相信這與幻魘有關。"
				before10: "我們拿到了另一個設施的位置，那裏應該有更多關於她的實驗的資訊。"
			}
			objectives: {
				reach-lady-doom: "飛往{1}-{0}個骷髏或更高的區域"
			}
		}
		story-lady-doom-expedition: {
			name: "探索危險實驗"
			expedition-name: "夢幻衛士基地廢墟"
			texts: {
				desc: "這個不尋常的實驗可能與幻魘的出現有關。"
			}
			dialogue: {
				before1: "我們到了，監察官。組建一支探索隊，瞭解更多有關厄運女士實驗的資訊吧。"
