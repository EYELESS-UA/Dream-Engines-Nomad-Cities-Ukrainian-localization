		story-dreamguard-expedition: {
			name: "探索夢幻衛士"
			expedition-name: "被遺棄的夢幻衛士基地"
			texts: {
				desc: "你瞭解到一個古老的組織-夢幻衛士。"
			}
			dialogue: {
				before1: "夢幻衛士基地就在附近。派一支探索隊吧，監察官。"
			}
			objectives: {
				perform-expedition: "完成探索：{0}"
