		story-drepattack: {
			name: "Gestrandet"
			texts: {
				desc: "Der Datenträger zieht die Traumplagen an und blockiert die Flugfähigkeit der Stadt."
			}
			dialogue: {
				before1: "Aufseher, wir haben das Gerät repariert. Es enthält wirklich Informationen, aber stört seltsamerweise auch unsere TraumTek."
				before2: "Aufseher, wir haben einen Notfall! Unsere Späher haben eine große Gruppe Traumplagen auf dem Weg zur Stadt gemeldet und das Gerät stört unsere Motoren. Die Stadt fliegt nicht."
				before3: "Kümmere dich um die Verteidigung der Stadt, Aufseher. Ich werde das Gerät abschalten."
			}
			objectives: {
				defeat-attack: "Verteidige deine Stadt"
			}
		}
		story-dreamguard-fly: {
			name: "Traumwache"
			texts: {
				desc: "Du erfährst mehr über eine alte Organisation namens Traumwache."
			}
			dialogue: {
				before1: "Es ist vorbei, aber wir mussten das Gerät zerstören. Vorher konnten wir aber noch ein paar Informationen entnehmen."
				before2: "Wir haben Informationen über eine dunkle Zeit für die alten Völker gefunden. Sie nannten sie „Die Albtraumjahre“. Es war eine Zeit, als die alten Völker schreckliche TraumTek-Waffen nutzten, um untereinander Krieg zu führen."
				before3: "Die Kriege endeten damit, das Twyst beinahe zerstört wurde. Dem zufolge, was wir erfahren konnten, endete es mit dem Sieg einer Organisation, die „Traumwache“ genannt wurde."
				before4: "Sie waren skrupellos und herrschten über ganz Twyst, nachdem sie die Kriege gewonnen hatten."
				before5: "Über die Ursprünge der Traumplagen gibt es keine Informationen. Vielleicht waren sie eine Art Waffe, die von der Traumwache eingesetzt wurde?"
				before6: "Vielleicht können wir mehr herausfinden, wenn wir die Überreste einer ihrer Basen finden. Wir wissen von einer im Aschfall-Gebirge."
				before7: "Die Region ist heiß. Zu heiß für unsere Stadt ohne den entsprechenden Schutz."
				before8: "Wir können eine Hitzeschild-Erweiterung im Stadtkern installieren, die die ganze Stadt beschützt, aber wir müssen sie zuerst erforschen."
			}
			objectives: {
				build-heatshield: "Baue eine {3} in deiner {0}"
				reach-lava: "Fliege zur Region: {0}"
			}
		}
		story-dreamguard-expedition: {
			name: "Expedition: Traumwache"
			expedition-name: "Verlassene Traumwachenbasis"
			texts: {
