	missions: {
		dialogue-goals-format: "{0}\n\n<color=#99EEFF>Aufgabe\n{1}</color>"
		dialogue-goals-line: "• {0}"
		story-start: {
			name: "Eine neue Hoffnung"
			texts: {
				desc: "Die Hoffnung deines Stamms wird durch die Entdeckung einer alten, fliegenden Stadt neu entfacht."
			}
			dialogue: {
				before1: "Aufseher, das ist unglaublich! Ein wahres Wunder der Antike."
				before2: "Man nannte dies eine „Nomadenstadt“. Sie kann fliegen! Wir wissen nicht, warum sie aufgegeben wurde. Es scheint noch alles zu funktionieren."
				before3: "Aufseher, die Stadt hat einen Avatar. Das ist ein mechanischer Riese, den sie „Tiny“ nannten. Muss eine Art Witz der Antike sein."
				before4: "Er ist bewaffnet. Damit können wir unsere Umgebung erkunden, Ressourcen finden und die Traumplagen bekämpfen."
				before5: "Das Blatt könnte sich zu unseren Gunsten wenden. Wir können hier ein echtes Zuhause bauen, eines, das uns überall hinbringt, wenn wir zur Flucht gezwungen sind."
				before6: "Du betrittst die Kammer des Aufsehers im Stadtkern. Von hier aus kannst du Tiny und die gesamte Stadt steuern. Du spürst, dass das lediglich der Beginn deiner Reise ist. Große Herausforderungen stehen dir bevor, aber auch eine neue Hoffnung. Du beginnst, dich mit der Steuerung von Tiny vertraut zu machen und träumst davon, eine riesige Stadt zu errichten, wie es damals üblich war."
			}
			objectives: {
				complete-tutorial: "Schließe die Einleitung ab"
				city-level1: "Erreiche eine Bevölkerung von {1}"
			}
		}
		story-buildlab: {
			name: "Forschung"
			texts: {
				desc: "Der Stamm möchte forschen, um die Stadt zu verbessern."
			}
			dialogue: {
				before1: "Wir haben einen guten Start hingelegt, Aufseher. Ich kann mich nicht daran erinnern, unsere Leute jemals so aufgeregt gesehen zu haben."
				before2: "Wir können hier etwas wirklich Großartiges aufbauen, aber wir müssen unsere eigene Forschung betreiben, wenn wir die Stadt ausbauen und verteidigen wollen."
				before3: "Die Infrastruktur der Stadt befindet sich in recht gutem Zustand, aber sie ist alt. Antik sogar. Vielleicht könnten wir eine Werkstatt erforschen, die Teile zur Aufrüstung dieser Infrastruktur herstellen kann."
			}
			objectives: {
				city-level2: "Erreiche eine Bevölkerung von {1}"
				buildlab: "Baue: {0}"
				unlockworkshop: "Erforsche {0}"
			}
		}
		story-upgrade-core: {
			name: "Stadtkern"
			texts: {
				desc: "Das Verbessern des Stadtkerns kann deinen Bewohnern beim Überleben helfen."
			}
			dialogue: {
				before1: "Aufseher, du kannst jetzt eine Werkstatt bauen, um Teile zu produzieren, mit denen wir die Infrastruktur der Stadt verbessern können."
				before2: "Unsere Wissenschaftler haben auch ein paar Verbesserungen für den Stadtkern entworfen. Verbessern wir als Nächstes den Kern. Damit wird seine Flugfähigkeit und Ressourcenproduktion verbessert."
				before3: "Aufseher, denk daran, dass die Traumplagen immer aggressiver werden, je länger wir an einem Ort verweilen."
				before4: "Wenn es zu gefährlich wird, oder du Ressourcen brauchst, die es in diesem Gebiet nicht gibt, kannst du die Stadt an einen anderen Ort fliegen."
			}
			objectives: {
				upgrade-core2: "Verbesserung: {3}"
			}
		}
		story-build-expeditioncenter: {
			name: "Expeditionszentrum"
			texts: {
				desc: "Du stellst Nachforschungen zu den Nomadenstädten und ihren ursprünglichen Bewohnern an."
			}
			dialogue: {
				before1: "Aufseher, ich habe etwas Interessantes in den Stadtarchiven entdeckt. Ich habe Hinweise auf eine Forschungseinrichtung irgendwo in der Wüste gefunden, die an etwas namens „Projekt Nomade“ geforscht hat."
				before2: "Ich glaube, dass diese Einrichtung der Ursprung der Nomadenstädte ist. Wenn wir sie untersuchen, finden wir vielleicht heraus, was mit den alten Stadtbewohnern passiert ist und ob es noch andere solcher Städte gibt."
				before3: "Ich suche noch immer nach dem genauen Standort dieser Einrichtung. Erforsche und baue in der Zwischenzeit bitte ein Expeditionszentrum, von dem aus wir Expeditionen organisieren und aussenden können."
				before4: "Aufseher, denk daran, dass die Traumplagen immer aggressiver werden, je länger wir an einem Ort verweilen. Wenn es zu gefährlich wird, oder du Ressourcen brauchst, die es in diesem Gebiet nicht gibt, kannst du die Stadt an einen anderen Ort fliegen."
				before5: "Manche der Ressourcen, die wir für das Expeditionszentrum benötigen, sind nur in Wüstengebieten zu finden."
			}
			objectives: {
				build-expeditioncenter: "Baue: {0}"
			}
		}
		story-cityorigin-fly: {
			name: "Stadtursprünge"
			texts: {
				desc: "Du stellst Nachforschungen zu den Nomadenstädten und ihren ursprünglichen Bewohnern an."
			}
			dialogue: {
				before1: "Aufseher, wir glauben, die Nomaden-Forschungseinrichtung gefunden zu haben. Sie befindet sich im nahegelegenen Wüstengebiet mit einer Gefahrenwertung von 2 Totenköpfen."
				before2: "Orte mit höheren Gefahrenwertungen beherbergen stärkere Traumplagen. Stelle bitte sicher, dass Tiny gut ausgerüstet ist und die Stadt gut verteidigt wird, bevor du in gefährlichere Gebiete fliegst."
			}
			objectives: {
				reach-desert2: "Fliege zu einer {0}-Region mit{1} Totenköpfen oder mehr."
			}
		}
		story-cityorigin-expedition: {
			name: "Expedition: Stadtursprünge"
			expedition-name: "Nomaden-Forschungseinrichtung"
			texts: {
				desc: "Du stellst Nachforschungen zu den Nomadenstädten und ihren ursprünglichen Bewohnern an."
			}
			dialogue: {
				before1: "Aufseher, wir haben sie gefunden, die Nomaden-Forschungseinrichtung. Sie ist nicht weit entfernt, du kannst also eine Expedition für die Untersuchung dieser Ruinen zusammenstellen."
			}
			objectives: {
				perform-expedition: "Schließe folgende Expedition ab: {0}"
			}
		}
		story-dreamplagues-fly: {
			name: "Traumplagen"
			texts: {
				desc: "Du musst mehr über die Traumplagen und die Wirkung der Städte auf sie erfahren."
			}
			dialogue: {
				before1: "Aufseher, wir haben etwas gefunden. Es ist … verstörend."
				before2: "Das Projekt Nomade wurde aufgegeben. Diese Stadt ist die einzige, die jemals gebaut wurde, und sie wurde nie bewohnt."
				before3: "Wie du bereits weißt, basiert TraumTek auf der Verbindung zwischen unserer Realität und dem Traumreich."
				before4: "Wenn wir schlafen, wandert unser „Bewusstsein“ oder unsere „Seele“ ins Traumreich, um sich dort wieder aufzuladen. Dort existieren die Gesetze der Natur nicht. In unseren Träumen ist alles möglich."
				before5: "Die Traummotoren zapfen das Traumreich an und entziehen ihm Flux, die Essenz des Reichs. Das Flux wird dann in TraumTek-Geräten verwendet, um die Realität unserer physischen Welt zu verzerren."
				before6: "Unseren Nachforschungen zu folge bauten die alten Völker die Nomadenstädte, um den Traumplagen zu entkommen. Aber sie haben einen Nebeneffekt festgestellt."
				before7: "Aus irgendeinem Grund haben die Städte die Lage nur verschlimmert. Um sie herum sind neue Albtraumrisse erschienen und die Traumplagen wurden schon fast magisch von den Städten angezogen."
				before8: "Außerdem glaubten sie, dass die dadurch entstandenen Schäden dauerhaft waren. Sie haben das Projekt aufgegeben. Es war zu riskant."
				before9: "Aufseher, wir können die Stadt nicht aufgeben. Noch nicht. Vielleicht haben sich die alten Völker geirrt. Vielleicht hat sich die Lage über die Jahrhunderte geändert. Unser Volk kann nicht zu seinem vorherigen Leben zurückkehren. Das würden wir nicht überleben."
				before10: "Lass uns bitte noch weitere Nachforschungen anstellen, bevor du eine Entscheidung triffst. Wir haben Hinweise auf eine weitere Forschungseinrichtung gefunden, eine, die die Traumplagen untersucht hat."
				before11: "Lass mich danach suchen, vielleicht finde ich dort Antworten."
			}
			objectives: {
				reach-tier3: "Baue deine Stadt weiter aus, bis die Forschungseinrichtung gefunden wurde."
			}
		}
