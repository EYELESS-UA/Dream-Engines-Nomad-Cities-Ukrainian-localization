		}
		dreammixture: {
			name: "Flüssiger Traum"
			desc: "Diese mysteriöse Flüssigkeit hat sehr ähnliche Eigenschaften wie Flux, ist aber viel stabiler und für physikalische Anwendungen flexibler."
		}
		dreamcrystal: {
			name: "Albtraumkristalle"
			desc: "Mit flüssigem Traum durchtränkte Kristalle. Der Prozess verdreht und verdunkelt die Kristalle, daher kommt ihr Name."
