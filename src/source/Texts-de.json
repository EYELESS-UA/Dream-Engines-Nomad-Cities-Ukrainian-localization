		all: {
			name: "Alle"
		}
		funds: {
			name: "Flux"
			desc: "Diese Substanz, die Grundlage aller Traumtek, wird aus dem Traumreich gewonnen und kann die Realität verzerren, um außerphysische Dinge geschehen zu lassen."
		}
		power: {
			name: "Energie"
			desc: "Tesla-Energie, die verwendet wird, um die meisten Maschinen zu betreiben."
		}
		worker: {
			name: "Arbeiter"
			desc: "Bürger, die in der Stadt arbeiten. Für die meisten Gebäude benötigt.\n\nBaue und verbessere Häuser, um die max. Anzahl der Arbeiter erhöhen. Sie werden im Stadtkern produziert."
		}
		fuel: {
			name: "Motortreibstoff"
			desc: "Wird fürs Fliegen benutzt und um einem schrecklichen Tod zu entgehen."
		}
		upgradeparts: {
			name: "Verbesserungsmaterialien"
			desc: "Wird verwendet, um deine provisorische Infrastruktur zu verbessern und dauerhafte Boni zu erhalten."
		}
		convert-funds: {
			name: "Umwandlungsmaterialien"
			desc: "Rohstoffe für Ruinen zur Ressourcenumwandlung."
		}
		research-points: {
			name: "Wissen"
			desc: "Wissen ist erforderlich, um Forschungen abzuschließen.\n\nErzeugt von verrückten Wissenschaftlern in Forschungslaboren."
		}
		comingsoon: {
			name: "Bald verfügbar"
			desc: "Diese Funktion ist noch nicht verfügbar."
		}
		food: {
			name: "Nahrung"
			desc: "Eine Art Treibstoff für Menschen. Wird regelmäßig von Häusern benötigt.\n\nProduziert im Nahrungswerk."
		}
		bloodwoodlog: {
			name: "Blutholzstämme"
			desc: "Stämme, die mit leuchtend roten Adern durchzogen sind. Müssen vor der Verwendung verarbeitet werden.\n\nWerden aus Ressourcenknoten geerntet."
		}
		rawfeatherstone: {
			name: "Unverarbeiteter Federstein"
			desc: "Dieser Stein ist immun gegen die Schwerkraft, was ihn sehr nützlich beim Bau von Flugobjekten (wie zum Beispiel Städten) macht.\n\nWird aus Ressourcenknoten geerntet."
		}
		crystal: {
			name: "Kristall"
			desc: "Geerntet von Ressourcenknoten, die in Wüstengebieten vorkommen."
		}
		cabtus: {
			name: "Kabtus"
			desc: "Fleischige Frucht, die in Wüstengebieten wächst."
		}
		purptato: {
			name: "Purptoffeln"
			desc: "Schmeckt wie eine eingefärbte Kartoffel. Kann im Nahrungswerk zu gerade noch essbarem Fraß verarbeitet werden."
		}
		rawcopper: {
			name: "Unverarbeitetes Kupfer"
			desc: "Das Metall der Wahl für viele Dampfmaschinen. Wird im Schmelzofen zu brauchbaren Barren verarbeitet.\n\nWird aus Ressourcenknoten geerntet. Erscheint in Gebieten mit höherem Schwierigkeitsgrad."
		}
		glowhoney: {
			name: "Leuchthonig"
			desc: "Radioaktiver Honig. Als Nahrung kaum brauchbar, kann aber zu hochwertigem Treibstoff für fliegende Städte verarbeitet werden.\n\nWird aus Ressourcenknoten geerntet. Erscheint in Gebieten mit höherem Schwierigkeitsgrad."
		}
		sulfur: {
			name: "Schwefel"
			desc: "Übelriechend, aber nützlich.\n\nWird aus Ressourcenknoten gewonnen. Erscheint in Gebieten mit höherem Schwierigkeitsgrad."
		}
		liquidfire: {
			name: "Flüssiges Feuer"
			desc: "Eine ewig heiße Flüssigkeit.\n\nGeerntet von Ressourcenknoten in Aschebiomen."
		}
		candyshroom: {
			name: "Süßpilz"
			desc: "Dieser riesige Pilz in Süßigkeitenform ist nicht nur nahrhaft, sondern auch reich an Flux.\n\nGeerntet von Ressourcenknoten in Giftbiomen."
		}
		startar: {
			name: "Sternstaub-Teer"
			desc: "Seine traumhaften Eigenschaften sind ein Hinweis darauf, dass er aus einer anderen Dimension stammt. Die meisten Böden enthalten Spurenelemente, die mit speziellen Maschinen extrahiert werden können.\n\nBaue einen Teer-Extraktor in der Stadt."
		}
		acidshard: {
			name: "Säurescherben"
			desc: "Kristallisierte Version der Säurepools, die im Ödland häufig vorkommen.\n\nWerden aus Ressourcenknoten geerntet. Erscheinen in Gebieten mit höherem Schwierigkeitsgrad."
		}
		glueberry: {
			name: "Klebeere"
			desc: "Viele arme Seelen sind erstickt, nachdem sie eine probieren wollten und ihr Mund davon zugeschweißt wurde."
		}
		smokegel: {
			name: "Rauchgel"
			desc: "Mit der richtigen Technik lässt sich selbst Umweltverschmutzung in etwas Brauchbares umwandeln."
		}
		toxicgoo: {
			name: "Giftiger Glibber"
			desc: "Eine giftige Substanz, die aus dem Boden extrahiert werden kann. Kann viel effizienter in Giftbiomen extrahiert werden."
		}
		refinedtar: {
			name: "Verarbeiteter Teer"
			desc: "Verarbeiteter Sternstaub-Teer mit höherer Flux-Konzentration"
		}
		stickytar: {
			name: "Klebriger Teer"
			desc: "Extraklebrige fluxerfüllte Substanz"
		}
		drepjuice: {
			name: "Albtraumsaft"
			desc: "Fließt oft in den Adern von biologischen Treps."
		}
		drepdust: {
			name: "Trepstaub"
			desc: "Dieser Staub ist der Überrest eines Treps."
		}
		dreptech: {
			name: "Stromdraht"
			desc: "Überreste von technologischen Treps."
		}
		oldscraps: {
			name: "Alte-Welt-Schrott"
			desc: "Kleine Teile aus der alten Welt. Könnten nützlich sein, wenn du herrenlose Maschinen der alten Welt verwenden willst."
		}
		dreamcore: {
			name: "Traumkern"
			desc: "Der Gipfel der Altwelt-Technologie. Diese seltenen Artefakte finden sich in Ruinen und bei Expeditionen und können zum Bau und zur Herstellung verwendet werden."
		}
		warpedwood: {
			name: "Blutholzbretter"
			desc: "Starkes und dennoch leichtes Holz, das in vielen Bau- und Herstellungsentwürfen in den Nomadenstädten verwendet wird.\n\nWird im Holzkrümmer aus Blutholzstämmen produziert."
		}
		featherstone: {
			name: "Zerstoßener Federstein"
			desc: "Verarbeiteter Federstein wird beim Bau verwendet, um Gebäude zu verstärken und ihr Gewicht zu verringern."
		}
		starwood: {
			name: "Sternholz"
			desc: "Sternstaub-Teer, der in Blutholzbrettern eingefasst ist, macht sie robuster und verleiht ihnen übernatürliche Eigenschaften.\n\nWird im Holzkrümmer aus Blutholzbrettern und Sternstaub-Teer produziert."
		}
		atlasbolt: {
			name: "Atlas-Bolzen"
			desc: "Schießbolzen aus Blutholzbrettern mit spezieller Anti-Albtraum-Beschichtung. Erforderlich, um Tinys Fernkampfwaffen abzufeuern."
		}
		feathercrystal: {
			name: "Federkristall"
			desc: "Kristall in Verbindung mit Federstein. Kristallknoten kommen in Wüstengebieten vor."
		}
		acidwood: {
			name: "Säureholz"
			desc: "Säurebehandeltes Blutholz."
		}
