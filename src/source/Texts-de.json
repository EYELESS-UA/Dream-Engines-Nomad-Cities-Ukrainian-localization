		flyengine: {
			name: "Schwebegerät"
			desc: "Bringt Dinge zum Schweben. Erhöht das maximale Gewicht der Stadt, aber auch die Treibstoffkosten für das Fliegen.\n\nDarf nicht zu nah an anderen schwebenden Geräten gebaut werden."
		}
		scoutpost: {
			name: "Kundschafterposten"
			desc: "Dient der Erkundung von fernem Land. Jeder Kundschafterposten fügt ein kostenloses Neuwürfeln bei der Auswahl des nächten Zielorts hinzu."
		}
		researchlab: {
			name: "Forschungslabor"
			desc: "Erforsche neue Technologien. Man weiß, dass hier durchgeführte Experimente schwere Mutationen verursacht haben."
		}
		teslatower: {
			name: "Tesla-Turm"
			desc: "Diese Türme erweitern das Stromversorgungsgebiet der Stadt. Nicht hochklettern."
		}
		longrange-power: {
			name: "Weitläufiges Stromzentrum"
			desc: "Diese Stromzentren verbinden die umliegenden Gebäude mit der Hauptstromversorgung.\n\nIm Gegensatz zu Tesla-Türmen müssen diese nicht selbst im Stromversorgungsgebiet sein, sie besitzen ihre eigene weitreichende Verbindung."
		}
		woodturret: {
			name: "Holzturm"
			desc: "Hält Albträume mit großen Leuchtpfeilen in Schach. Verlangsamte Feuerrate mit explosiven Angriffen, die mehreren Zielen Flächenschaden zufügen. Schwach gegen gepanzerte Ziele."
		}
		stoneturret: {
			name: "Steinturm"
			desc: "Ein Steinturm mit einer Zahnradkanone. Explosive Angriffe mit höherer Feuerrate als bei einem Holzturm."
		}
		flameturret: {
			name: "Teerbombenturm"
			desc: "Schießt entflammbare Teerbomben. Feuert langsamer, aber mit deutlich größerer Reichweite und fügt in einem großen Umkreis mehr Schaden zu als der Holzturm."
		}
		atlasturret: {
			name: "Atlas-Turm"
			desc: "Ein stärkerer und robusterer Schießturm mit Schnellfeuer, aber ohne Flächenschaden. Besonders stark gegen gepanzerte Ziele."
		}
		musicturret: {
			name: "Trompeterturm"
			desc: "Dieser langsam feuernde Turm sendet eine markerschütternde Schallwelle aus, die dem Ziel Schaden zufügt und auch andere Personen in seiner Umgebung schwer beschädigt."
		}
