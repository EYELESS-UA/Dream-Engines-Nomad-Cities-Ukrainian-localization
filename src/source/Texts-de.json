			}
			remove-upgrade: {
				title: "Erweiterung entfernen?"
				text: "Willst du diese Erweiterung wirklich entfernen? Du erhältst nur einige Rohmaterialien zurück."
			}
			skip-tutorial-new: {
				title: "Einleitung überspringen?"
				text: "Dream Engines besitzt einzigartige Spielmechaniken. Wenn du die Einleitung überspringst, könntest du Probleme mit der Spielsteuerung bekommen. Wir empfehlen, die Einleitung zu spielen, es dauert auch nicht lange.\n\nWillst du die Einleitung wirklich überspringen?"
			}
			skip-tutorial-task: {
				title: "Einleitungsaufgabe überspringen?"
				text: "Möchtest du diese Einleitung wirklich überspringen, ohne die Aufgabe abzuschließen? Du kannst sie stets im Hilfe-Fenster nachschlagen."
			}
			skip-tutorial-updated: {
				title: "Einleitung überspringen?"
				text: "Wir haben viele wichtige Änderungen vorgenommen, seitdem du die Einleitung gespielt hast.\n\nWillst du die Einleitung wirklich überspringen?"
			}
			different-mods: {
				title: "Verschiedene Mods"
				text: "Das Spiel, das du lädst, wurde mit anderen Mods gespielt als den derzeit aktiven. In einigen Fällen könnte dies problemlos funktionieren, aber in anderen kann das Spiel möglicherweise nicht geladen werden oder andere Probleme beim Spielen verursachen.\n\nFortfahren?"
			}
			below-recommended-version: {
				title: "Neues Spiel wird empfohlen"
				text: "Du versuchst einen Speicherstand von einer älteren Version zu laden. Es ist möglich, dass wesentliche Änderungen vorgenommen wurden und einige Dinge funktionieren daher vielleicht nicht mehr. Wir empfehlen dir, ein neues Spiel zu starten oder zum Spielen <color=#99EEFF><u><link=\"old-version\">eine ältere Version von Dream Engines herunterzuladen</link></u></color>\n.\nFortfahren?\n\n"
			}
			multi-demolish: {
