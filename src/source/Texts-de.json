		story-lady-doom-fly: {
			name: "Gefährliche Experimente"
			texts: {
				desc: "Ein ungewöhnliches Experiment hat vielleicht etwas mit dem Auftauchen der Traumplagen zu tun."
			}
			dialogue: {
				before1: "Aufseher, wir haben so viel über die Traumwache erfahren. Wir lagen völlig falsch. Sie waren überhaupt keine Eroberungstruppe."
				before2: "Als Twyst beinahe zerstört war, beschlossen alle Nationen gemeinsam, den Krieg zu beenden. Sie unterzeichneten das Traumwachenabkommen und einigten sich darauf, den Einsatz und die Erforschung von TraumTek zu beschränken. Besonders TraumTek-Waffen wurden strengstens verboten."
				before3: "Die Traumwache wurde gegründet, um die Einhaltung des Abkommens zu überwachen. Sie waren in der Tat skrupellos in der Überwachung von der Verwendung von TraumTek, aber unter ihrem friedewarenden Blick gedieh Twyst."
				before4: "Es wurden große Stadtstaaten gegründet, in denen die Bewohner glücklich und frei leben konnten. Alles Militär, außer der Traumwache selbst, wurde aufgelöst und große Ressourcenmengen wurden in das Wohlbefinden der Leute investiert."
				before5: "Wir können von solch friedlichen und lukrativen Zeiten nur träumen."
				before6: "Zu dieser Zeit existierten die Traumplagen noch nicht. Was auch immer sie sind, sie wurden nicht während der Kriege geschaffen."
				before7: "Aber wir haben eine andere Spur. Wie gut das Leben zu dieser Zeit auch war, es gab trotzdem Kriminalität. Gier und Machthunger fassten noch immer in manchen Menschen Fuß."
				before8: "Einer dieser Verbrecher wird erwähnt. Eine verrückte Wissenschaftlerin, bekannt als „Die Dame des Untergangs“. Sie führte illegale TraumTek-Experimente durch und schaffte es, der Traumwache zu entgehen."
				before9: "Die genaue Art ihrer Experimente ist unklar. Doch wir vermuten, dass es etwas mit den Traumplagen zu tun hat."
				before10: "Wir haben den Standort einer weiteren Einrichtung, dort sollte es weitere Informationen über ihre Experimente geben."
			}
			objectives: {
				reach-lady-doom: "Fliege zu einer anderen Region mit {1} Totenköpfen oder mehr."
			}
		}
		story-lady-doom-expedition: {
			name: "Expedition: Gefährliche Experimente"
			expedition-name: "Ruinen der Traumwachenbasis"
			texts: {
				desc: "Ein ungewöhnliches Experiment hat vielleicht etwas mit dem Auftauchen der Traumplagen zu tun."
			}
			dialogue: {
				before1: "Wir sind da, Aufseher. Bereiten wir die Expedition vor und erfahren mehr über die Experimente der Dame des Untergangs."
			}
			objectives: {
				perform-expedition: "Schließe folgende Expedition ab: {0}"
			}
		}
		story-researchshield: {
			name: "Experimentelle Substanzen"
			texts: {
				desc: "Du suchst nach einer langfristigen Lösung, um dich vor den Traumplagen zu schützen."
			}
			dialogue: {
				before1: "Aufseher, wir konnten mehr über die Dame des Untergangs und ihre Experimente in Erfahrung bringen. Sie war machthungrig."
				before2: "Sie glaubte, es wäre nur die Spitze des Eisbergs, das Traumreich anzuzapfen und Flux zu verwenden, um die Realität zu verändern. Wenn sie in ihrer physischen Form ins Traumreich reisen könnte, würde sie allmächtig werden. Die Naturgesetze würden nicht länger gelten und sie könnte alles tun, nur weil sie es wollte."
				before3: "Sie war besessen. Sie experimentierte vor den Augen des Traumwächters, und schließlich hatte sie Erfolg. Außerdem lag sie ganz furchtbar falsch."
				before4: "Das Traumreich ist ein Ort der puren Energie. Von dem, was wir herausgefunden haben, wurde ihr Körper verdreht und verzerrt und sie wurde von der bloßen Kraft dieses Reichs zerquetscht."
				before5: "Geschichten sagen, ihr Bewusstsein sei noch immer im Traumreich gefangen, in ewigem Leid, nicht in der Lage, in eine Realität zurückzukehren, in der ihr Körper nicht länger existiert."
				before6: "Aufseher, das ist noch nicht alles. Das Traumreich … wir dachten, es sei unbewohnt. Das ist es nicht. Die Daten ihrer Experimente zeigen, dass sie etwas geweckt hat, als sie ihren physischen Körper ins Traumreich transferiert hat."
				before7: "Irgendetwas lebt dort. Und als die Dame des Untergangs ihr Experiment durchführte, wurde dieses Etwas auf uns aufmerksam. Auf unsere Realität."
				before8: "Sie haben keine physischen Körper, sie können in unserer Welt nicht existieren. Aber die Dame des Untergangs erschuf einen Bruch, einen Riss zwischen unseren Reichen. Und dort hindurch können die Wesen unsere Welt beeinflussen. Sie können von Lebewesen und sogar unbelebten Gegenständen Besitz ergreifen."
				before9: "Das sind die Traumplagen. Sie dürsten danach, in dieser physischen Welt zu sein, doch können sie nur von physischen Objekten Besitz ergreifen. Und sie sind hungrig, immer hungrig, nach unseren lebenden Körpern."
				before10: "Sie tauchten überall auf Twyst auf. Zuerst in kleiner Zahl, aber für jedes Nest, das die Traumwache zerstörte, für jeden von ihnen geschlossenen Riss, erschienen mehrere neue."
				before11: "Die Traumwache war überfordert. Die Stadtstaaten fielen. Twyst selbst veränderte sich, verzerrte sich und wurde zu dem dunklen Ort, den wir heute kennen."
				before12: "Aufseher, ich bin nicht sicher, was wir tun sollen. Die Stadt, sie schadet der Welt. Solch eine große Menge an TraumTek an einem Ort. Der Schleier zwischen den Reichen wird dadurch geschwächt und der Riss erweitert. Doch ist es auch unsere einzige Hoffnung zu überleben."
				before13: "Die Traumwache experimentierte mit einer anderen Substanz. Man könnte es eine Anti-Traum-Substanz nennen, eine Art Gegenkraft zum Flux des Traumreichs. Sie hofften, diese Substanz würde im Kampf gegen die Traumplagen helfen."
				before14: "Versuchen wir, mehr darüber herauszufinden."
			}
			objectives: {
				perform-research: "Erforsche: {0}"
			}
		}
		story-buildshield: {
			name: "Der Preis des Überlebens"
			texts: {
				desc: "Du suchst nach einer langfristigen Lösung, um dich vor den Traumplagen zu schützen."
			}
			dialogue: {
				before1: "Aufseher, wir haben es geschafft. Wir haben einen Weg gefunden, einen steten Fluss der Anti-Traum-Substanz herzustellen."
				before2: "Wir können eine Art Negationsschild bauen. Die alten Völker konnten ihn nicht bauen, da die Traumplagen ihre Forschung vernichteten, sobald sie mit dem Anti-Traum experimentierten."
				before3: "Aber wir haben die Stadt, wir können in Bewegung bleiben. Wir können beenden, was sie angefangen haben, aber es wird reichlich Ressourcen und Materialien erfordern, die nicht leicht zu finden sind."
				before4: "Es gibt einen Vorbehalt, Aufseher. Der Schild kann uns vor den Traumplagen beschützen. Sie können die Realität darin nicht beeinflussen und die Dinge, von denen sie Besitz ergriffen haben, werden zu leblosen Hüllen."
				before5: "Aber unsere TraumTek funktioniert darin auch nicht. Der Flux wird inaktiv. Wir überleben, werden aber hier feststecken."
				before6: "Es ist deine Entscheidung, Aufseher. Wir können für immer fliegen und gegen die wachsende Anzahl an Traumplagen kämpfen, oder du baust und aktivierst den Negationsschild."
				before7: "Wenn du dich entscheidest, den Schild zu bauen, denk daran, dass es eine ganze weile dauern wird, ihn vollständig aufzuladen. Währenddessen werden viele Traumplagen angelockt werden."
				before8: "Wir entkommen dem Angriff an ein weniger gefährliches Gebiet, aber der Schild ist sehr schwer und die Motoren brauchen auch eine Weile, um abzukühlen, bevor wir wieder fliegen können. Unsere Verteidigung wird auf die Probe gestellt."
			}
			objectives: {
				build-shield: "Baue: {0}"
				activate-shield: "Überlebe, bis er vollständig aufgeladen ist."
			}
		}
	}
