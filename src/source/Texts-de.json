		presets: {
			very-easy: {
				name: "Entspannt"
				desc: "Dieser Schwierigkeitsgrad ist am besten für alle geeignet, die eher an Erkundung und dem Bauen interessiert sind.\n\nIn diesem Modus erhöht sich der globale Befall nur dann, wenn du selbst auf einer Karte mit höherem Schwierigkeitsgrad landest.\n\nFeinde greifen deine Stadt immer noch an, ihre Bedrohungsstufe steigt jedoch deutlich langsamer. Wenn du Angriffe vollständig deaktivieren möchtest, kannst du unten die Bedrohungsschwierigkeit anpassen."
			}
			easy: {
				name: "Gnädig"
				desc: "Ein geringeres Spieltempo, das auch Fehler zulässt, beliebiges Speichern erlaubt und im Allgemeinen schwächere Feinde bietet.\n\nEmpfohlen für Spieler, die mit dem Genre nicht vertraut sind oder jene, die eine entspannte Spielerfahrung suchen, aber trotzdem etwas Zeitdruck und Herausforderung möchten."
			}
			beginner: {
				name: "Noch im Lernprozess"
				desc: "Der empfohlene Schwierigkeitsgrad für neue Spieler.\n\nErlaubt ein langsameres Spieltempo und bietet einfachere Kämpfe, damit du dich mit dem Spiel vertraut machen kannst.\n\nNach einige Versuchen und sobald du dich in die einzigartige Steuerung und die Systeme eingearbeitet hast, empfehlen wir, auf den Schwierigkeitsgrad „Herausfordernd“ zu wechseln."
			}
			no-time-limit: {
				name: "Lass dir Zeit"
				desc: "Ähnelt dem Schwierigkeitsgrad „Herausforderndׅ, mit der Ausnahme, dass der globale Befall nie von selbst steigt.\n\nIn diesem Modus ist der Druck deutlich verringert, denn du kannst so viele Karten geringerer Stufen besuchen, wie du möchtest, bevor du dich bereit fühlst, Karten höherer Stufen zu besuchen. Es besteht immer noch Zeitdruck auf jeder Karte, da Angriffe und Bedrohungsstufe normal steigen, jedoch werden diese zurückgesetzt, wenn du auf eine neue Karte des gleichen Schwierigkeitsgrads fliegst."
			}
			economy-focus: {
				name: "Ökonomische Herausforderung"
				desc: "Für alle, die größere Herausforderung in den Bau- und Verwaltungsaspekten des Spiels suchen.\n\nDer Schwierigkeitsgrad der Kämpfe ähnelt dem Schwierigkeitsgrad „Noch im Lernprozess“, jedoch sind Ressourcen schwerer zu finden und Baukosten sind erhöht."
			}
			challenging: {
				name: "Herausfordernd"
				desc: "So sollte das Spiel gespielt werden.\n\nEmpfohlen für Spieler, die bereits mit den einzigartigen Systemen und der Steuerung vertraut sind und sich einer echter Herausforderung stellen wollen."
			}
			hard: {
				name: "Schwer"
				desc: "Für alle, die eine noch größere Herausforderung suchen.\n\nMehr Feinde in allen Situationen und ein beschleunigter Anstieg der Bedrohungsstufe, erhöhen den Zeitdruck deutlich."
			}
			very-hard: {
				name: "Traumplage"
				desc: "Der höchste Schwierigkeitsgrad.\n\nTiny ist schwächer, du findest weniger Ressourcen, zahlst mehr für den Bau und der globale Befall steigt schneller, als auf dem Schwierigkeitsgrad „Schwer“.\n\nSpielen auf eigene Gefahr."
			}
			custom: {
				name: "Benutzerdefiniert"
				desc: ""
			}
		}
	}
	opening-story: {
		paragraph1: {
			text1: "Twyst."
			text2: "Einst eine Welt voller Wunder und Träume."
			text3: "Jetzt ist es ein Ort voller Albträume."
		}
		paragraph2: {
			text1: "Mit der Entdeckung der realitätsverändernden Technologie, die als „TraumTek“ bekannt ist, wurde Twyst zur Heimat vieler großer und wohlhabender Reiche."
			text2: "Das sagen zumindest die Legenden."
		}
		paragraph3: {
			text1: "Dann kamen die Traumplagen."
			text2: "Niemand weiß, woher sie kamen. Kreaturen, die direkt aus einem Albtraum zu entspringen scheinen."
			text3: "Sie tauchten überall auf, aber die Welt war darauf nicht vorbereitet."
			text4: "Die Twystaner bekämpften sie mutig, doch die schrecklichen Traumplagen schienen kein Ende zu nehmen. Große Städte fielen, Reiche wurden dezimiert."
		}
		paragraph4: {
			text1: "Jahrhunderte später wurde Twyst selbst zu einem dunklen, verzerrten Planeten."
			text2: "Die wenigen verbliebenen Twystaner überleben nun als Nomadenstämme, die nie Wurzeln schlagen und nie zu lange an einem Ort bleiben. Sie sind stets in Bewegung und auf der Flucht vor den Traumplagen."
			text3: "Hier beginnt deine Geschichte."
		}
	}
