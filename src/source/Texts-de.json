		}
		smokedfire: {
			name: "Rauchfeuer"
			desc: "Rauchgel hilft, das flüssige Feuer zu stabilisieren und macht es fast sicher zu handhaben."
		}
		carbonite: {
			name: "Karbonit"
			desc: "Kristalle, die mit Kohlenstoffmischung verarbeitet wurden."
		}
