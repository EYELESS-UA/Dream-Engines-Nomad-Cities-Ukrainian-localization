	mapobjects: {
		citytile: {
			name: "Stadterweiterung"
			desc: "Wir können nicht einfach Dinge auf dem Boden bauen und erwarten, dass sie fliegen. Erweitere das Stadtgebiet, um seine Fläche zu vergrößern."
		}
		roadtile: {
			name: "Schienen"
			desc: "Einbahngleise, auf denen Minenwagen Ressourcen wie von selbst zwischen Gebäuden transportieren.\n\nZiehe, um sie zu bauen. Ziehe sie auf vorhandene Schienen, um die Richtung zu ändern."
