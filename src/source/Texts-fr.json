			name: "Matérialiseur"
			desc: "Utilise le flux et des matières premières renouvelables pour créer des ressources impossibles à produire autrement dans la ville.\n\nPermet un repos aussi coûteux que nécessaire à Mini."
		}
		storage: {
			name: "Point de réserve"
