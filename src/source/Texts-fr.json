			dialogue: {
				before1: "Superviseur, nous pensons que le centre de recherches sur les rêves plaies devrait se trouver dans les champs oniriques. Veuillez nous y mener dès que possible."
			}
			objectives: {
				reach-blue: "Voler jusqu'à la région : {0}"
			}
		}
		story-dreamplagues-expedition: {
