				text: "Il existe déjà une partie en mode extrême avec ce nom. Démarrer une nouvelle partie avec le même nom écrasera l'ancienne sauvegarde.\n\nVous pouvez saisir un nom de ville différent si vous souhaitez conserver la sauvegarde précédente.\n\nÉcraser la sauvegarde ?"
			}
			no-overseer: {
				title: "Outils de superviseur désactivés"
				text: "Vous avez choisi de désactiver les outils de superviseur. Vous ne pourrez pas accélérer ni mettre en pause le jeu, et la caméra sera verrouillée sur Mini. Vous devrez donc vous déplacer pour gérer votre ville. Continuer ?"
			}
			remove-upgrade: {
				title: "Retirer l'extension ?"
				text: "Voulez-vous vraiment retirer cette extension ? Vous ne récupérerez qu'une partie des matières premières."
			}
			skip-tutorial-new: {
				title: "Passer le didacticiel ?"
				text: "Dream Engines propose des mécaniques uniques, passer le didacticiel pourrait avoir des conséquences sur votre expérience. Nous vous recommandons de le suivre, il est très court.\n\nVoulez-vous vraiment passer le didacticiel ?"
			}
			skip-tutorial-task: {
				title: "Passer la tâche du didacticiel ?"
				text: "Voulez-vous vraiment passer ce didacticiel sans terminer la tâche ? Vous pouvez la retrouver à tout moment dans la fenêtre d'aide."
			}
			skip-tutorial-updated: {
				title: "Passer le didacticiel ?"
				text: "Nous avons fait d'importants changements depuis la dernière fois que vous avez fait le didacticiel. Nous vous recommandons de le refaire.\n\nVoulez-vous vraiment passer le didacticiel ?"
			}
			different-mods: {
				title: "Mods différents"
				text: "La partie que vous chargez a été jouée avec un ensemble de mods différents de ceux actuellement actifs. Dans certains cas, cela peut fonctionner sans problème, mais il se peut parfois que le jeu ne se charge pas ou que d'autres problèmes surviennent durant la partie.\n\nContinuer ?"
			}
			below-recommended-version: {
				title: "Nouvelle partie recommandée"
				text: "Vous essayez de charger une partie issue d'une version précédente. Même si cela est possible, de nombreux changements ont été apportés et pourraient empêcher certains éléments de fonctionner comme prévu. Nous vous recommandons fortement de commencer une nouvelle partie ou de <color=#99EEFF><u><link=\"old-version\">télécharger une ancienne version de Dream Engines</link></u></color> pour jouer avec cette partie.\n\nContinuer ?\n\n"
			}
			multi-demolish: {
				title: "Tout démolir ?"
				text: "Vous allez démolir {0} objets différents. Continuer ?"
			}
			demolish-upgrades: {
				title: "Démolir les améliorations ?"
				text: "Le bâtiment que vous êtes en train de démolir possède des améliorations ou des extensions. Continuer ?"
			}
			cancel-expedition: {
				title: "Annuler l'expédition ?"
				text: "Ceci annule l'expédition actuelle. Si l'expédition est en phase de préparation, vous perdrez uniquement les ressources dépensées jusqu'ici.\n\nSi l'expédition est déjà en cours, l'équipe d'expédition sera également perdue."
			}
			continue-after-winning: {
				title: "Continuer à jouer ?"
				text: "Vous pouvez maintenant commencer une nouvelle partie avec une autre difficulté ou une autre tribu, ou alors continuer de jouer et continuer à agrandir votre ville. Si vous choisissez de continuer, vous êtes libre de démolir le Bouclier neutralisateur.\n\nContinuer ?"
			}
		}
