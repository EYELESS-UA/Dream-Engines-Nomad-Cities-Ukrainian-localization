			expedition-name: "Centre de recherches sur les rêves plaies"
			texts: {
				desc: "Vous devez en apprendre plus sur les rêves plaies et sur la façon dont la ville les affecte."
			}
			dialogue: {
				before1: "Nous avons trouvé les ruines du centre de recherches sur les rêves plaies. Il est près d'ici. Organisons une expédition pour aller l'explorer."
			}
			objectives: {
				perform-expedition: "Terminer l'expédition : {0}"
			}
		}
		story-repair-informationstorage: {
			name: "Expédition sur les rêves plaies"
			texts: {
				desc: "Un appareil de stockage des données nous permettra peut-être d'en savoir plus sur les rêves plaies."
			}
			dialogue: {
				before1: "Notre expédition est de retour, Superviseur. L'état du centre de recherches était pire que ce que nous pensions, il n'en restait plus grand-chose."
				before2: "L'expédition a cependant découvert un appareil qui semblerait renfermer des informations sur les recherches menées au centre, mais nous devrons le réparer pour nous en assurer."
			}
			objectives: {
				repair-storage: "Fabriquer : {0}"
			}
		}
		story-drepattack: {
			name: "Échoué"
			texts: {
				desc: "L'appareil de stockage des données attire les rêves plaies et désactive les fonctions de lévitation de la ville."
			}
			dialogue: {
				before1: "Superviseur, nous avons réparé l'appareil. Il contient des informations, mais étrangement, il semble aussi affecter notre rêvetech."
				before2: "Superviseur, nous avons un problème ! Nos éclaireurs nous signalent un énorme groupe de rêves plaies se dirigeant droit sur nous, et l'appareil interfère avec nos moteurs, nous n'arrivons pas à faire voler la ville."
				before3: "Allez vous occuper des défenses de la ville, Superviseur. Je vais tenter de désactiver l'appareil."
			}
			objectives: {
				defeat-attack: "Défendez votre ville"
			}
		}
		story-dreamguard-fly: {
			name: "Garderêve"
			texts: {
				desc: "Vous apprenez l'existence d'une ancienne organisation nommée la Garderêve."
			}
			dialogue: {
				before1: "C'est fini, mais nous avons dû détruire l'appareil. Nous avons cependant réussi à en extraire des informations."
				before2: "Nous avons appris l'existence d'une période nommée les « Années cauchemardesques », une période sombre pour les anciens. Durant cette période, les anciens utilisèrent de dangereuses armes rêvetech pour se battre entre eux."
				before3: "Ces guerres ont failli détruire tout Retor. De ce que nous avons pu en découvrir, les vainqueurs de ces guerres étaient une organisation nommée la Garderêve."
				before4: "Ils étaient impitoyables, et après la fin des guerres, ils contrôlaient tout Retor."
				before5: "Il n'y a rien sur les origines des rêves plaies. Peut-être s'agissait-il d'une sorte d'arme utilisée par la Garderêve ?"
				before6: "Peut-être que si nous trouvons les vestiges d'une de leurs bases, nous en apprendrons plus. Nous avons des renseignements concernant l'une des bases de la Chaîne de cendrepluie."
				before7: "Cette région est torride. Notre ville aura besoin d'une protection appropriée."
				before8: "Nous pouvons installer une extension au cœur de la ville, un bouclier ignifugé qui protégera toute la ville, mais nous devrons d'abord rechercher cette technologie."
			}
			objectives: {
