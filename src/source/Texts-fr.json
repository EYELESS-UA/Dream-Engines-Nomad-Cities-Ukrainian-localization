		story-start: {
			name: "Un nouvel espoir"
			texts: {
				desc: "L'espoir de votre tribu est ravivé par la découverte d'une ancienne ville capable de voler."
			}
			dialogue: {
				before1: "Superviseur, c'est incroyable ! Une véritable merveille des anciens."
				before2: "Ils l'appelaient « ville nomade », elle est capable de voler ! Nous ignorons pourquoi ils l'ont abandonnée, tout semble fonctionnel."
				before3: "Superviseur, la ville possède un avatar. C'est un géant mécanique qu'ils appelaient « Mini ». Sûrement de l'humour ancien."
				before4: "Il est armé, nous pouvons l'utiliser pour explorer les environs, trouver des ressources et combattre les rêves plaies."
				before5: "C'est peut-être notre chance. Nous pouvons construire un véritable foyer, ici. Un que nous pouvons emmener avec nous dès que nous devons fuir."
				before6: "Vous entrez dans la chambre du superviseur, dans le cœur de la ville. D'ici, vous pouvez contrôler Mini ainsi que toute la ville. Vous sentez que ce n'est que le début de votre aventure. De grands défis nous attendent, mais aussi un nouvel espoir. Vous commencez à vous familiariser avec les commandes de Mini et rêvez de construire une grande ville, comme dans l'ancien temps."
			}
			objectives: {
				complete-tutorial: "Terminer le didacticiel"
				city-level1: "Atteindre une population de {1}"
			}
		}
		story-buildlab: {
			name: "Rechercher"
			texts: {
				desc: "La tribu espère mener ses propres recherches afin d'améliorer la ville."
			}
			dialogue: {
				before1: "Nous partons du bon pied, Superviseur, je ne me souviens pas d'avoir déjà vu les nôtres si impatients."
				before2: "Nous pouvons construire quelque chose de grandiose, ici, mais nous devrons faire nos propres recherches si nous voulons agrandir et défendre la ville."
				before3: "L'infrastructure de la ville est plutôt en bon état, mais elle est ancienne. Vraiment ancienne. Nous pouvons peut-être chercher un atelier pour produire des composants qui pourraient servir à améliorer cette infrastructure."
			}
			objectives: {
				city-level2: "Atteindre une population de {1}"
				buildlab: "Construire : {0}"
				unlockworkshop: "Rechercher {0}"
			}
		}
		story-upgrade-core: {
			name: "Cœur de la ville"
			texts: {
				desc: "Si vous améliorez le cœur de la ville, cela aidera votre peuple à survivre."
			}
			dialogue: {
				before1: "Superviseur, vous pouvez désormais construire un atelier pour produire des composants qui nous permettront d'améliorer l'infrastructure de la ville."
				before2: "Nos scientifiques ont également conçu de nouvelles améliorations pour le cœur de la ville. La prochaine fois, améliorons le cœur. Cela améliora sa capacité de vol et sa production de ressources."
				before3: "Superviseur, n'oubliez pas que plus nous restons au même endroit, plus les rêves plaies deviennent hostiles."
				before4: "Quand les choses tournent au vinaigre ou quand vous avez besoin de ressources introuvables dans une zone, vous pouvez déplacer la ville jusqu'à un nouvel emplacement."
			}
			objectives: {
				upgrade-core2: "Amélioration : {3}"
			}
		}
		story-build-expeditioncenter: {
			name: "Centre d'expédition"
			texts: {
				desc: "Vous enquêtez sur les origines des villes nomades et sur le sort de leurs habitants."
			}
			dialogue: {
				before1: "Superviseur, j'ai découvert quelque chose d'intéressant dans les archives de la ville. J'ai trouvé des mentions d'un centre de recherches dans le désert qui recherchait une chose appelée « projet Nomade »."
				before2: "Je pense que ce centre est l'origine des villes nomades. Nous pourrions l'étudier pour découvrir ce qui est arrivé aux anciens qui vivaient ici et si d'autres villes comme celle-ci existent."
				before3: "Je cherche toujours l'emplacement exact du centre. En attendant, recherchez et construisez un centre d'expédition qui nous permettra d'organiser et de lancer des expéditions."
				before4: "Superviseur, n'oubliez pas que plus nous restons au même endroit, plus les rêves plaies deviennent hostiles. Quand les choses tournent au vinaigre ou quand vous avez besoin de ressources introuvables dans une zone, vous pouvez déplacer la ville jusqu'à un nouvel emplacement."
				before5: "Certaines ressources dont nous avons besoin pour le centre d'expédition ne se trouvent que dans des zones désertiques."
			}
			objectives: {
				build-expeditioncenter: "Construire : {0}"
			}
		}
		story-cityorigin-fly: {
			name: "Origines de la ville"
			texts: {
				desc: "Vous enquêtez sur les origines des villes nomades et sur le sort de leurs habitants."
			}
			dialogue: {
				before1: "Superviseur, nous pensons avoir trouvé le centre de recherches nomade. Il se trouve dans une zone désertique proche dont le niveau de danger est de 2 crânes."
				before2: "Les emplacements dont le niveau de danger est élevé abritent des rêves plaies plus dangereux. Veuillez vous assurer que Mini est bien équipée et la ville bien défendue avant de vous envoler vers des zones plus dangereuses."
			}
			objectives: {
				reach-desert2: "Volez jusqu'à une région {0} à {1} crânes ou plus"
			}
		}
		story-cityorigin-expedition: {
			name: "Expédition aux origines de la ville"
			expedition-name: "Centre de recherches nomade"
			texts: {
				desc: "Vous enquêtez sur les origines des villes nomades et sur le sort de leurs habitants."
			}
			dialogue: {
				before1: "Superviseur, nous avons trouvé le centre de recherches nomade. Il n'est pas très loin. Vous pouvez organiser une expédition pour aller étudier les ruines."
			}
			objectives: {
				perform-expedition: "Terminer l'expédition : {0}"
			}
		}
		story-dreamplagues-fly: {
			name: "Rêves plaies"
			texts: {
				desc: "Vous devez en apprendre plus sur les rêves plaies et sur la façon dont la ville les affecte."
			}
			dialogue: {
				before1: "Superviseur, nous avons découvert quelque chose. C'est... assez perturbant."
				before2: "Le projet Nomade a été abandonné. La ville que nous avons trouvée est la seule à avoir été construite, et elle n'a jamais été habitée."
				before3: "Comme vous le savez, la rêvetech se base sur le lien entre notre réalité et le royaume du rêve."
				before4: "Lorsque nous dormons, notre « conscience », ou notre « âme », voyage jusqu'au royaume du rêve pour se recharger. Les lois de la nature n'existent pas en ce lieu. Tout est possible dans nos rêves."
				before5: "Dream Engines puise le flux depuis le royaume du rêve. Il s'agit de l'essence même de ce royaume. Le flux est ensuite utilisé dans les appareils rêvetech afin de modifier notre monde matériel."
				before6: "De ce que nous avons réussi à comprendre, les anciens ont construit les villes nomades afin d'échapper aux rêves plaies. Mais ils ont découvert un effet secondaire."
				before7: "Il semble que d'une façon ou d'une autre, les villes ont fait empirer les choses. De nouvelles failles cauchemardesques se sont mises à apparaître tout autour, et les rêves plaies ont été attirées par les villes comme jamais auparavant."
				before8: "Pire encore, ils pensaient que les dégâts provoqués étaient permanents. Le projet était trop risqué, et ils ont donc décidé de l'abandonner."
				before9: "Superviseur, nous ne pouvons pas abandonner la ville. Pas encore. Les anciens se trompaient peut-être. Peut-être que les choses ont changé après tous ces siècles. Notre peuple ne peut pas retourner à son ancien mode de vie. Nous ne pourrions pas survivre."
				before10: "Avant de prendre une décision, je vous prie de continuer vos recherches. Nous avons trouvé mention d'un autre centre de recherches qui étudiait les rêves plaies."
				before11: "Je vais essayer de le trouver. Il détient peut-être les réponses à nos questions."
			}
			objectives: {
				reach-tier3: "Continuez à développer votre ville jusqu'à ce que le centre de recherches soit trouvé."
			}
		}
