	mapobjects: {
		citytile: {
			name: "Agrandissement de ville"
			desc: "Nous ne pouvons pas simplement construire des choses et espérer qu'elles volent. Agrandissez les fondations de la ville pour en augmenter la taille."
		}
		roadtile: {
			name: "Rails"
			desc: "Rails à sens unique sur lesquels les wagons apparaissent comme par magie pour transporter les ressources entre les bâtiments.\n\nFaites glisser pour construire. Faites glisser en haut des rails existants pour ajouter ou modifier les directions."
		}
		railsplitter: {
			name: "Trieur"
			desc: "Trie les objets d'une entrée unique vers trois sorties. Vous pouvez déterminer la sortie vers laquelle vont les objets."
		}
		streettile: {
			name: "Rue"
			desc: "Elle n'est pas vraiment utile, mais elle est jolie et n'empêche pas les déplacements.\n\nUtile pour l'urbanisme et pour vous assurer d'avoir suffisamment de place pour vous déplacer en toute liberté."
		}
		player-debris: {
			name: "Bâtiment détruit"
		}
		commandcenter: {
			name: "Cœur de la ville"
			desc: "L'endroit qui fait tourner la ville. Nous ignorons comment en construire un autre, alors essayez de le protéger."
		}
		expeditioncenter: {
			name: "Centre d'expédition"
			desc: "Lancez des expéditions pour récupérer des ressources et des technologies anciennes."
		}
		flyengine: {
			name: "Appareil flottant"
			desc: "Permet aux choses de s'élever. Augmente le poids maximal de la ville, mais également le coût en carburant du vol.\n\nNe peut pas être construit trop près d'autres appareils flottants."
		}
		scoutpost: {
			name: "Poste d'exploration"
			desc: "Sert à explorer des terres lointaines. Chaque poste d'exploration ajoute une relance gratuite lors du choix de votre destination suivante."
		}
		researchlab: {
			name: "Laboratoire de recherche"
			desc: "Recherche de nouvelles technologies. Les expériences menées ici sont réputées pour provoquer de graves mutations."
		}
		teslatower: {
			name: "Tour tesla"
			desc: "Ces tours augmentent l'énergie produite par la ville. Ne pas escalader."
		}
		longrange-power: {
			name: "Plateforme d'énergie longue portée"
			desc: "Ces plateformes connectent les bâtiments autour d'elles à la source d'énergie principale.\n\nContrairement aux tours tesla, elles n'ont pas besoin de se trouver à portée de la source d'énergie, elles créent leur propre connexion longue portée."
		}
		woodturret: {
			name: "Tourelle en bois"
			desc: "Éloigne les cauchemars à coup de grandes flèches. Dispose d'une faible cadence de tir et d'attaques explosives qui infligent des dégâts de zone à de multiples cibles. Faible face aux cibles blindées."
		}
		stoneturret: {
			name: "Tourelle en pierre"
			desc: "Une tour en pierre équipée d'un canon mécanique. Dispose d'une cadence de tir plus élevée et d'attaques explosives qui infligent plus de dégâts que les tourelles en bois."
		}
		flameturret: {
			name: "Tourelle à bombe goudron"
			desc: "Tire des bombes de goudron inflammable. Tire plus lentement, mais à une portée bien plus élevée et inflige plus de dégâts dans une zone plus importante, en comparaison avec une tourelle en bois."
		}
		atlasturret: {
			name: "Tourelle atlas"
			desc: "Une baliste plus puissante et résistante à la cadence de tir élevée, mais qui n'inflige pas de dégâts de zone. Redoutable contre les cibles blindées."
		}
		musicturret: {
			name: "Tourelle-trompette"
			desc: "Cette tourelle à la cadence de tir faible émet une onde sonore dévastatrice qui inflige de lourds dégâts à sa cible ainsi qu'aux autres autour d'elle."
		}
		woodwall: {
			name: "Mur en bois"
			desc: "Protège les bâtiments derrière lui. Pendant un moment."
		}
		woodgate: {
			name: "Porte en bois"
			desc: "Une porte, vous pouvez la franchir, les rêvplaies ne peuvent pas."
		}
		stonewall: {
			name: "Mur en pierre"
			desc: "Protège les bâtiments derrière lui. Pendant un peu plus longtemps."
		}
		stonegate: {
			name: "Porte en pierre"
			desc: "Une porte plus solide, vous pouvez la franchir, les rêvplaies ne peuvent pas pendant plus longtemps."
		}
		wall: {
			name: "Mur"
			desc: "Protège vos bâtiments avec du métal."
		}
