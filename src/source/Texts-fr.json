		presets: {
			very-easy: {
				name: "Décontractée"
				desc: "Cette difficulté est plus adaptée à ceux intéressés par l'exploration et la construction.\n\nDans ce mode, l'infestation globale n'augmentera pas, sauf si vous décidez de vous rendre dans des cartes plus difficiles.\n\nLes ennemis attaqueront toujours votre ville, mais le niveau de menace augmentera bien plus lentement. Si vous voulez annuler les raids, vous pouvez paramétrer la difficulté de menace ci-dessous."
			}
			easy: {
				name: "Indulgente"
				desc: "Un rythme plus lent qui pardonne plus d'erreurs. Vous permet de sauvegarder à tout moment et comprend des ennemis plus faibles.\n\nRecommandé pour les joueurs qui n'ont pas l'habitude de ce genre de jeu ou pour ceux qui souhaitent une expérience plus décontractée mais comprenant quand même un minimum de défi."
			}
			beginner: {
				name: "Apprentissage"
				desc: "Difficulté recommandée aux nouveaux joueurs.\n\nLe rythme plus lent et les batailles plus faciles vous permettront de vous familiariser avec le jeu.\n\nUne fois que vous maîtriserez les commandes et systèmes uniques du jeu, nous vous recommandons de passer en difficulté Exigeante."
			}
			no-time-limit: {
				name: "Prenez votre temps"
				desc: "Semblable à la difficulté Exigeante, sauf que le niveau d'infestation globale n'augmente jamais par lui-même.\n\nCe mode est bien moins stressant car vous pouvez visiter autant de cartes de bas niveau que vous le souhaitez avant de visiter des cartes de niveau plus élevé. Vous avez toujours la pression du temps passé sur chaque carte car les raids et le niveau de menace augmentent normalement, mais voler vers une nouvelle carte de la même difficulté les réinitialise."
			}
			economy-focus: {
				name: "Défi économique"
				desc: "Pour ceux qui préfèrent un défi plus axé sur la construction et la gestion.\n\nLa difficulté des combats est similaire à la difficulté Apprentissage, mais les ressources sont plus rares et les coûts de construction sont plus élevés."
			}
			challenging: {
				name: "Exigeante"
				desc: "C'est ainsi que le jeu devrait être joué.\n\nRecommandé aux joueurs qui sont familiarisés avec les systèmes et commandes uniques au jeu et qui sont prêts pour un véritable défi."
			}
			hard: {
				name: "Difficile"
				desc: "Pour ceux qui apprécient un défi plus difficile.\n\nIl y a plus d'ennemis et le niveau de menace augmente plus vite."
			}
			very-hard: {
				name: "Rêve plaies"
				desc: "La difficulté la plus élevée.\n\nMini est plus faible, vous trouverez moins de ressources, paierez plus pour construire, et l'infestation globale augmentera plus vite qu'en difficulté Difficile.\n\nJouez à vos propres risques et périls."
			}
			custom: {
				name: "Personnalisé"
				desc: ""
			}
		}
	}
	opening-story: {
		paragraph1: {
			text1: "Retor."
			text2: "Autrefois un monde de rêves et de merveilles."
			text3: "Désormais un lieu de cauchemars."
		}
		paragraph2: {
			text1: "Grâce à la découverte de la « rêvetech », une technologie qui défie la réalité, Retor devint le foyer de nombreux empires prospères."
			text2: "Du moins, c'est ce que disent les légendes."
		}
		paragraph3: {
			text1: "Puis arrivèrent les rêves plaies."
			text2: "Personne ne sait d'où ils viennent. Des créatures qui semblaient venir tout droit de leurs cauchemars."
			text3: "Elles surgirent de nulle part, et le monde n'était pas prêt."
			text4: "Les retordiens combattirent avec courage, mais les rêves plaies étaient innombrables et infatigables. De grandes villes tombèrent, des empires furent décimés."
		}
		paragraph4: {
			text1: "Des siècles plus tard, Retor devint une sombre planète corrompue."
			text2: "Les derniers retordiens survirèrent en tant que tribus nomades, sans jamais s'installer, sans jamais rester trop longtemps au même endroit. Toujours en mouvement, avant que les rêves plaies ne puissent les trouver."
			text3: "C'est là que commence votre histoire."
		}
	}
