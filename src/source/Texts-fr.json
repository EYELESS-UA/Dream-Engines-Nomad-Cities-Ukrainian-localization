		}
		importer: {
			name: "Dépôt de ressource"
			desc: "Un endroit où déposer les matières premières sans avoir à construire de rails depuis les récolteurs.\n\nLes wagons des récolteurs ne peuvent pas se déplacer dans la ville, le dépôt doit donc être construit au bord ou en dehors de la ville."
		}
		exporter: {
			name: "Empaqueteuse de ressources"
			desc: "Alimentez-la en ressources (y compris en ressources raffinées) par rails. Ces ressources seront envoyées au dépôt de ressource disponible le plus proche.\n\nLes wagons ne peuvent pas se déplacer dans la ville. Construisez au bord ou en dehors de la ville."
		}
