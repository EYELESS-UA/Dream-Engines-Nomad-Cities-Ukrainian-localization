			expedition-name: "Ruines de la base de la Garderêve"
			texts: {
				desc: "L'apparition des rêves plaies est peut-être liée à une expérience inhabituelle."
			}
			dialogue: {
				before1: "Nous sommes arrivés, Superviseur. Commençons l'expédition et tentons d'en savoir plus sur les expériences de la Dame de la damnation."
