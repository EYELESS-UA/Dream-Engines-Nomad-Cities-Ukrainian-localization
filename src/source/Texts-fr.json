			expedition-name: "Base de la Garderêve abandonnée"
			texts: {
				desc: "Vous apprenez l'existence d'une ancienne organisation nommée la Garderêve."
			}
			dialogue: {
				before1: "La base de la Garderêve est près d'ici. Superviseur, envoyons une expédition."
			}
			objectives: {
				perform-expedition: "Terminer l'expédition : {0}"
			}
