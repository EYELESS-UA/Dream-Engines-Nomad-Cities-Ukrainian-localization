			expedition-name: "ノマド研究施設"
			texts: {
				desc: "ノマドシティの原点とその住民に何が起こったのかを調査します。"
			}
			dialogue: {
				before1: "監督官、見つけました。ノマドの研究施設です。それほど遠くないので、この廃墟を調査するための探索隊を結成しましょう。"
			}
