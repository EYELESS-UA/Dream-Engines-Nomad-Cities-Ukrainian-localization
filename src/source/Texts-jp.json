	missions: {
		dialogue-goals-format: "{0}\n\n<color=#99EEFF>目標\n{1}</color>"
		dialogue-goals-line: "• {0}"
		story-start: {
			name: "新たなる希望"
			texts: {
				desc: "空飛ぶ古代都市が発見され、あなたの部族に再び希望が甦りました。"
			}
			dialogue: {
				before1: "監督官、なんという素晴らしいことなんでしょう！まさに古代人の奇跡です。"
				before2: "彼らはそれを「ノマドシティ」と呼び、空を飛べるんです！まだ機能しているのに、なぜ放棄されたのかはわかりません。"
				before3: "この街にはアバターがいます。「タイニー」と呼ばれる機械の巨人です。恐らく古代人の冗談でしょう。"
				before4: "武装しているので、周囲を探索したり、リソースを探したり、ドリームプレイグと戦ったりするのに使えます。"
				before5: "私たちの運命を変えることができるかもしれません。ここにいつでも逃げ出せるような本当の家を建てましょう。"
				before6: "シティコアの監視室に入ります。ここからタイニーと街全体をコントロールすることができます。これは単なる旅の始まりに過ぎないと感じるでしょう。大きな苦難が待ち受けていると同時に新たな希望もあります。あなたは段々とタイニーの操作に慣れ始め、昔のような壮大な都市を築くことを志すでしょう。"
			}
			objectives: {
				complete-tutorial: "チュートリアルを完了してください。"
				city-level1: "人口{1}に達します。"
			}
		}
		story-buildlab: {
			name: "研究"
			texts: {
				desc: "部族は、街を発展させるために独自の調査と研究を行いたいと考えています。"
			}
			dialogue: {
				before1: "私たちは幸先のいいスタートを切りました。こんなに興奮している仲間を見たのは初めてです。"
				before2: "ここで素晴らしいことができるかもしれません。しかし、この街を発展させ、守るためには、自分たちで調査をする必要があります。"
				before3: "街のインフラは比較的良好ですが、街自体は本当に古いです。インフラをアップグレードするには、それ用の部品を製造するワークショップを研究した方がいいでしょう。"
			}
			objectives: {
				city-level2: "人口{1}に達します。"
				buildlab: "{0}を建てます。"
				unlockworkshop: "{0}を研究します。"
			}
		}
		story-upgrade-core: {
			name: "シティコア"
			texts: {
				desc: "シティコアをアップグレードすることで、市民の生存を確保します。"
			}
			dialogue: {
				before1: "監察官、ワークショップを建設し、街のインフラアップグレードに必要な部品を生産することができるようになりました。"
				before2: "科学者たちは、シティコアのアップグレードをいつくか設計しました。シティコアをアップグレードし、飛行能力と資源生産を強化させましょう。"
				before3: "監察官、私たちが一つの場所にとどまればとどまるほど、ドリームプレイグの攻撃性は強くなるということを忘れないでください。"
				before4: "危険な状況に陥ったときや、この地域で手に入らない資源が必要になったときは、街を新しい場所に飛ばすことができます。"
			}
			objectives: {
				upgrade-core2: "アップグレード: {3}"
			}
		}
		story-build-expeditioncenter: {
			name: "エクスペディションセンター"
			texts: {
				desc: "ノマドシティの原点とその住民に何が起こったのかを調査します。"
			}
			dialogue: {
				before1: "監督官、私は街のアーカイブで興味深いものを発見しました。砂漠のどこかに『プロジェクト・ノマド』と呼ばれるものを研究している研究施設があることがわかったんです。"
				before2: "私はこの施設がノマドシティの原点だと考えています。調査を進めれば、ここに住んでいた古代人に何が起こったのか、他にもそのような都市があるのかを知ることができるかもしれません。"
				before3: "施設の正確な場所をまだ探索中です。その間に、探索隊を派遣できるエクペディションセンターを建てましょう。"
				before4: "監察官、私たちが一つの場所にとどまればとどまるほど、ドリームプレイグの攻撃性は強くなるということを忘れないでください。危険な状況に陥ったときや、この地域で手に入らない資源が必要になったときは、街を新しい場所に飛ばすことができます。"
				before5: "エクスペディションセンターに必要な資源の中には、砂漠地帯でしか手に入らないものもあります。"
			}
			objectives: {
				build-expeditioncenter: "{0}を建てます。"
			}
		}
		story-cityorigin-fly: {
			name: "街の原点"
