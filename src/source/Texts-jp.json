	tribes: {
		scavengers: {
			name: "ジャンクロード"
			desc: "ジャンクロードは廃品のマスターです。他の部族が、古い世界のゴミや特徴のない青い箱しか見ていないのに対し、彼らは宝物を見つけました。彼らの専門知識は、あらゆる廃品を見つけ出し、利用することで、古代の遊牧民の都市を修復と維持するのに非常に役立っています。"
		}
		dreamweavers: {
			name: "ドリームウィーバー"
			desc: "ドリームウィーバーは、旧世界のテクノロジーの仕組みを完全には理解していなくても、ドリームテックを巧みに操ることができます。彼らはフラックスの生成に非常に長けており、より多くのマテリアを扱うことができます。\n\nしかし、それらのスキルには代償が伴います。彼らは夢の世界に魅了され、時々実験を行うため、ドリームイーターは彼らの存在に気づきました。"
			unlocktext: "アンロック方法：他の部族との対戦中に3,000個のフラックスを獲得"
		}
		electric: {
			name: "テスラアクト"
			desc: "テスラエネルギーの達人である彼らは、電力だけで資源を複製することができる独自の技能を持っています。テスラアクトの主な欠点は、少しの電力で充分と思っているので、基本となる発電器は非常に効率が悪いことです。"
			unlocktext: "ロック解除条件：1サイクルあたりの総発電量（消費前）が600パワーであること"
		}
		builders: {
			name: "ビーバー"
			desc: "ビーバー族はその優秀な建築プロジェクトで有名です。自分たちの都市を素早く簡単に拡張することができ、少ない資源で建物をアップグレードすることができます。しかし、彼らは大事なプロジェクトを置き去りにしたくないため、都市周辺で建てることしかできません。無駄遣いと置き去りを好まないプレーヤーにはとっておきの部族です。"
			unlocktext: "アンロック条件：一つのゲームで都市を5回拡張する。"
		}
		explorers: {
			name: "レムナントシーカー"
			desc: "レムナントシーカーは探検部族であり、救いは過去にあると信じています。経験豊富で効率的なエクスペディション隊員を活かし、旧世界の遺跡探索に命をかけています。彼らが飛行に使うタイニーは低燃費且つ高速ですが、防御を通常より弱く、リサーチの効率もあまりよくありません。"
			unlocktext: "アンロック条件：一つのゲームでエクスペディションを5回完成すること。"
		}
		gatherers: {
			name: "テラ・マルタ"
			desc: "テラ・マルタ族（略して「テラン」）は、自然が提供する資源を最大限に活用することができる勤勉な人々です。彼らは資源収穫が得意であり、ノードを枯渇させる前に更に多くの資源を採取することができます。また、各マップでリストとは異なる種類の資源ノードをランダム（レベル次第）に1つ発見することができます。\n\nしかし、彼らは合成資源を信じておらず、マテリアライザーを全く使用しないため、生資源の精製が比較的遅いです。"
			unlocktext: "アンロック方法：2スカル以上のマップ全ての資源ノードにハーベスタを建ててください。"
		}
		hunters: {
			name: "プレイグハンター"
			desc: "夢の災いが出現しはじめるようになった頃、プレイグハンターと呼ばれる軍事組織が出現した。何世紀経った今でも、彼らの子孫は世界中をさまよい、チャンスがあればドリームプレイグを狩り、その亡骸を使って生き延びている。\n\nプレイグハンターは戦闘に優れ、倒したドレップから資源を抽出し、その使い道を見つけ出す。しかし、彼らは最高のエンジニアを戦争に送り出したため、生産施設は最も効率的だとは言えない。"
			unlocktext: "アンロック方法：タイニーと1回の対戦でドリームプレイグを150体倒す。"
		}
		nomads: {
			name: "伝承者"
			desc: "伝承の番人は歴史学者であり、旧世界のあらゆるものの専門家でもあります。できるだけ多くの廃墟を訪れたい彼らは、他の部族よりもさらに遊牧民的で、効率的な都市移動を完成させ、遠くから廃墟を発見することができます。彼らは常に旧世界のものに手を出すため、ドレップにいち早く気づかれ強襲されます。"
			unlocktext: "アンロックするには：1回のゲームで10個の異なる廃墟と接触することです。"
		}
		doomed: {
			name: "悪運部族"
			desc: "彼らは呪われているのだと感じる人もいます。不運で、物事が思い通りに進まず、全てが困難そして彼らの前に立ちはだかります。悪運部族とは、そのような不運な人々の集まりなのです。\n\n彼らはドリームプレイグに見つかりやすく、より危ない地域に身を置き、リソースが乏しく、生活が非常に困難です。そんな過酷な生活を送ることで、彼らはより逞しくなり、生き残るために必要なものも少なくなっていきました。"
			unlocktext: "アンロックするには：脅威レベル30以上のレイドから生き残ることです。"
		}
	}
