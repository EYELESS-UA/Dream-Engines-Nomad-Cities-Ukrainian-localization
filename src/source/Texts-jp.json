		presets: {
			very-easy: {
				name: "リラックス"
				desc: "この難易度は、探索や建築に興味のある方に最適です。\n\nこのモードでは、自分で難易度の高いマップに移動しない限り、世界侵入の難易度は増えません。\n\n敵は依然としてあなたの都市を攻撃しますが、危険度の上昇は非常に緩やかです。レイドを完全にキャンセルしたい場合は、以下の脅威の難易度設定をカスタマイズできます。"
			}
			easy: {
				name: "ノーマル"
				desc: "ゆっくりとしたペースで、より多くのミスを許容し、常にゲームをセーブでき、しかも全ての敵は弱いです。\n\n初心者はもちろん、リラックスしたいプレッシャーにもお勧めです。"
			}
			beginner: {
				name: "学習中"
				desc: "初心者におすすめの難易度です。\n\nゆっくりとしたペースで、より簡単なバトルが楽しめます。\n\n何度か挑戦して、独特の操作方法やシステムに慣れてきたら、難易度を「挑戦」に切り替えることをおすすめします。"
			}
			no-time-limit: {
				name: "ゆっくりしてください"
				desc: "挑戦的な難易度と似ていますが、世界侵入レベルが自動的に上昇することはありません。\n\nこのモードでは、高レベルのマップに行く準備ができるまで、低レベルのマップを好きなだけ訪れることができるため、プレッシャーが大幅に軽減されます。レイドや危険度は通常通り上昇しますので、各マップ内でのタイムプレッシャーはあります。しかし、同じ難易度の新しいマップに飛ぶと、これらがリセットされます。"
			}
			economy-focus: {
				name: "経済への挑戦"
				desc: "建物の建設や管理に挑戦したい方にお勧めです。\n\n戦闘の難易度は「学習中」に似ていますが、資源の入手が困難になり、建設コストも増えます。"
			}
			challenging: {
				name: "挑戦"
				desc: "これこそが、このゲームの本来の姿です。\n\nこのゲームのユニークなシステムや操作性に慣れて、本格的に挑戦したい方にお勧めです。"
			}
			hard: {
				name: "ハード"
				desc: "さらなる挑戦を楽しみたい方にお勧めです。\n\n周りの敵数が大幅に増え、脅威度も上がり、より大きな時間のプレッシャーを感じることとなります。"
			}
			very-hard: {
				name: "ドリームイーター"
				desc: "最も難しい難易度です。\n\nタイニーは弱く、資源も少なく、物を作るのに大量のお金が必要で、ハードレベルに比べて世界侵入の速度も明らかに速くなっています。\n\n身の安全を守ってください。"
			}
			custom: {
				name: "カスタム"
				desc: ""
			}
		}
	}
	opening-story: {
		paragraph1: {
			text1: "トワイスト。"
			text2: "かつては驚きと夢の世界でした。"
			text3: "今は悪夢の場所です。"
		}
		paragraph2: {
			text1: "ドリームテックという現実を覆す技術の発見により、トワイストは多くの偉大で繁栄した帝国の本拠地となりました。"
			text2: "少なくとも、伝説ではそうなっています。"
		}
		paragraph3: {
			text1: "そして、ドリームプレイグがやってきました。"
			text2: "どこから来たのか、誰も知りません。悪夢からそのまま生まれたような生き物です。"
			text3: "奴らは至る所に現れ、世界はそれに対応できませんでした。"
			text4: "ツイスタンたちは勇敢に戦ったが、ドリームプレイグはとどまることなく襲いかかりました。大都市は没落し、帝国は壊滅しました。"
		}
		paragraph4: {
			text1: "数世紀後、トワイスト自体は暗く歪んだ惑星となりました。"
			text2: "わずかに残ったツイスタン人は遊牧民として、根を下ろすこともなく、同じ場所に長く留まることもなく、ドリームプレイグが彼らの匂いを嗅ぎつける前に、常に移動しているのです。"
			text3: "ここからあなたの物語が始まります。"
		}
	}
